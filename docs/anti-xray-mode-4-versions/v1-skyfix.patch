+    private boolean shouldSkipObfuscation(boolean exposed, int localX, int localZ, int worldY, int localY, Level level, int chunkMinBlockX, int chunkMinBlockZ, int[] surfaceHeights, BlockPos.MutableBlockPos skyCheckPosition) {
+        if (!exposed) {
+            return false;
+        }
+
+        if (engineMode != EngineMode.HIDE_AS_AIR || surfaceHeights == null || !level.dimensionType().hasSkyLight()) {
+            return true;
+        }
+
+        // The first layer read for a section is only used to initialize the occlusion mask.
+        if (localY < 0) {
+            return true;
+        }
+
+        // Keep the terrain surface and everything above it, including trees.
+        if (worldY >= surfaceHeights[(localZ << 4) | localX]) {
+            return true;
+        }
+
+        // Preserve exposed terrain that still receives meaningful skylight. Deep,
+        // dark cave walls stay hidden, while shaded slopes and overhangs remain intact.
+        int worldX = chunkMinBlockX + localX;
+        int worldZ = chunkMinBlockZ + localZ;
+        for (Direction direction : DIRECTIONS) {
+            skyCheckPosition.set(worldX + direction.getStepX(), worldY + direction.getStepY(), worldZ + direction.getStepZ());
+            if (level.getBrightness(LightLayer.SKY, skyCheckPosition) >= 8) {
+                return true;
+            }
+        }
+
+        return false;
+    }

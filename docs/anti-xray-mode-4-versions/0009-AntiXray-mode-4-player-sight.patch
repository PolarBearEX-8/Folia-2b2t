+    private boolean isVisibleFromPlayer(Level level, ChunkPacketInfoAntiXray.PlayerView playerView, int blockX, int blockY, int blockZ, BlockPos.MutableBlockPos rayCheckPosition) {
+        double targetX = blockX + 0.5D - playerView.eyeX();
+        double targetY = blockY + 0.5D - playerView.eyeY();
+        double targetZ = blockZ + 0.5D - playerView.eyeZ();
+        double distanceSquared = targetX * targetX + targetY * targetY + targetZ * targetZ;
+        if (distanceSquared < 1.0E-6D) {
+            return true;
+        }
+
+        double viewDot = targetX * playerView.directionX() + targetY * playerView.directionY() + targetZ * playerView.directionZ();
+        if (viewDot < Math.sqrt(distanceSquared) * MODE4_VIEW_HALF_ANGLE_COSINE) {
+            return false;
+        }

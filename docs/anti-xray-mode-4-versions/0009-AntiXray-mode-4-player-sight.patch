+    private boolean hasLineOfSight(Level level, ChunkPacketInfoAntiXray.PlayerView playerView, int targetBlockX, int targetBlockY, int targetBlockZ, double deltaX, double deltaY, double deltaZ, BlockPos.MutableBlockPos rayCheckPosition) {
+        int steps = Math.min(1024, (int) Math.ceil(Math.max(Math.max(Math.abs(deltaX), Math.abs(deltaY)), Math.abs(deltaZ)) * 2.0D));
+        if (steps <= 1) {
+            return true;
+        }
+
+        int previousX = (int) Math.floor(playerView.eyeX());
+        int previousY = (int) Math.floor(playerView.eyeY());
+        int previousZ = (int) Math.floor(playerView.eyeZ());
+        int loadedChunkX = Integer.MIN_VALUE;
+        int loadedChunkZ = Integer.MIN_VALUE;
+        LevelChunk loadedChunk = null;
+
+        for (int step = 1; step < steps; step++) {
+            double progress = step / (double) steps;
+            int x = (int) Math.floor(playerView.eyeX() + deltaX * progress);
+            int y = (int) Math.floor(playerView.eyeY() + deltaY * progress);
+            int z = (int) Math.floor(playerView.eyeZ() + deltaZ * progress);
+            if (x == previousX && y == previousY && z == previousZ) {
+                continue;
+            }
+            previousX = x;
+            previousY = y;
+            previousZ = z;
+
+            if (x == targetBlockX && y == targetBlockY && z == targetBlockZ) {
+                continue;
+            }
+            if (y < level.getMinY() || y > level.getMaxY()) {
+                continue;
+            }
+
+            int chunkX = x >> 4;
+            int chunkZ = z >> 4;
+            if (chunkX != loadedChunkX || chunkZ != loadedChunkZ) {
+                loadedChunk = level.getChunkIfLoaded(chunkX, chunkZ);
+                loadedChunkX = chunkX;
+                loadedChunkZ = chunkZ;
+                if (loadedChunk == null) {
+                    return false;
+                }
+            }
+
+            rayCheckPosition.set(x, y, z);
+            BlockState state = loadedChunk.getBlockState(rayCheckPosition);
+            if (state.isAir()) {
+                continue;
+            }
+            try {
+                if (solidGlobal[GLOBAL_BLOCKSTATE_PALETTE.idFor(state, PaletteResize.noResizeExpected())]) {
+                    return false;
+                }
+            } catch (MissingPaletteEntryException ignored) {
+                // Unknown block states block visibility rather than exposing the target.
+                return false;
+            }
+        }
+
+        return true;
+    }

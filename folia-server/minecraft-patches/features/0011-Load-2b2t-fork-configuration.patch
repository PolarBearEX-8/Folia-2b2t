From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Folia 2b2t Contributors <noreply@folia2b2t.dev>
Date: Mon, 8 Sep 2026 22:30:00 +0700
Subject: [PATCH] Load 2b2t fork configuration

Load config/2b2tfolia.yml at startup. Its Ender Pearl stasis settings control
whether the ticket is reapplied when a pearl enters the loaded state.

---
 .../entity/server/ServerEntityLookup.java          |  2 +-
 .../paper/configuration/Folia2b2tConfiguration.java | 34 +++++++++++++++++++
 net/minecraft/server/dedicated/DedicatedServer.java  |  1 +
 3 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/server/ServerEntityLookup.java b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/server/ServerEntityLookup.java
index 1536a64a393bc1e9ace6fb34e359477bb6c744ae..666ffcfc7c6dc41ec293e79e8d8763ced71a97e5 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/server/ServerEntityLookup.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/server/ServerEntityLookup.java
@@ -35,7 +35,9 @@ public final class ServerEntityLookup extends EntityLookup {
     public ServerEntityLookup(final ServerLevel world, final LevelCallback<Entity> worldCallback) {
         super(world, worldCallback);
         this.serverWorld = world;
-        this.keepEnderPearlsTicking = PlatformHooks.get().addTicketForEnderPearls(world);
+        this.keepEnderPearlsTicking = PlatformHooks.get().addTicketForEnderPearls(world)
+            || (io.papermc.paper.configuration.Folia2b2tConfiguration.isEnderPearlStasisEnabled()
+                && !world.paperConfig().misc.legacyEnderPearlBehavior);
     }
 
     @Override
@@ -117,7 +117,7 @@ public final class ServerEntityLookup extends EntityLookup {
         // the same pearl-specific ticket after a loaded-state transition as well: the ticket
         // set de-duplicates this identifier, and this closes a transition window where the
         // entity becomes visible again after its original ticket operation was superseded.
-        if (entity instanceof ThrownEnderpearl enderpearl) {
+        if (io.papermc.paper.configuration.Folia2b2tConfiguration.reapplyEnderPearlTicketOnLoadedTransition() && entity instanceof ThrownEnderpearl enderpearl) {
             this.addEnderPearl(CoordinateUtils.getChunkKey(enderpearl.chunkPosition()), enderpearl.getId());
         }
         // Moonrise start - entity tracker
diff --git a/io/papermc/paper/configuration/Folia2b2tConfiguration.java b/io/papermc/paper/configuration/Folia2b2tConfiguration.java
new file mode 100644
index 0000000000000000000000000000000000000000..3363d44126072598c15f11ac4f648cf9957902a9
--- /dev/null
+++ b/io/papermc/paper/configuration/Folia2b2tConfiguration.java
@@ -0,0 +1,39 @@
+package io.papermc.paper.configuration;
+
+import java.io.File;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Configuration owned by the Folia 2b2t fork. */
+public final class Folia2b2tConfiguration {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger("Folia2b2tConfig");
+    private static final File FILE = new File("config", "2b2tfolia.yml");
+    private static volatile boolean enderPearlStasisEnabled = true;
+    private static volatile boolean reapplyEnderPearlTicketOnLoadedTransition = true;
+
+    private Folia2b2tConfiguration() {
+    }
+
+    public static void load() {
+        if (!FILE.isFile()) {
+            LOGGER.warn("{} was not found; using the default Ender Pearl stasis settings", FILE.getPath());
+            return;
+        }
+
+        final YamlConfiguration configuration = YamlConfiguration.loadConfiguration(FILE);
+        enderPearlStasisEnabled = configuration.getBoolean("ender-pearl-stasis.enabled", true);
+        reapplyEnderPearlTicketOnLoadedTransition = enderPearlStasisEnabled
+            && configuration.getBoolean("ender-pearl-stasis.reapply-ticket-on-loaded-transition", true);
+        LOGGER.info("Loaded {} (ender-pearl-stasis enabled: {}, reapply-ticket-on-loaded-transition: {})", FILE.getPath(), enderPearlStasisEnabled, reapplyEnderPearlTicketOnLoadedTransition);
+    }
+
+    public static boolean isEnderPearlStasisEnabled() {
+        return enderPearlStasisEnabled;
+    }
+
+    public static boolean reapplyEnderPearlTicketOnLoadedTransition() {
+        return reapplyEnderPearlTicketOnLoadedTransition;
+    }
+}
diff --git a/net/minecraft/server/dedicated/DedicatedServer.java b/net/minecraft/server/dedicated/DedicatedServer.java
index 3462c251057773384de4f9bfd418b5a40fb9181e..675422066b9dfeaf70f88fe1486797f3c7a440d7 100644
--- a/net/minecraft/server/dedicated/DedicatedServer.java
+++ b/net/minecraft/server/dedicated/DedicatedServer.java
@@ -261,6 +261,7 @@ public class DedicatedServer extends MinecraftServer implements ServerInterface
         this.paperConfigurations.initializeGlobalConfiguration(this.registryAccess());
         this.paperConfigurations.initializeWorldDefaultsConfiguration(this.registryAccess());
         // Paper end - initialize global and world-defaults configuration
+        io.papermc.paper.configuration.Folia2b2tConfiguration.load(); // Folia 2b2t - fork configuration
         this.server.spark.enableEarlyIfRequested(); // Paper - spark
         // Paper start - fix converting txt to json file; convert old users earlier after PlayerList creation but before file load/save
         if (this.convertOldUsers()) {

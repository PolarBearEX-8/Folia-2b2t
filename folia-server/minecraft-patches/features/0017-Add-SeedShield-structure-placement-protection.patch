     // Paper start - Add missing structure set seed configs
     public boolean applyAdditionalChunkRestrictions(final int sourceX, final int sourceZ, final long levelSeed, final @org.jspecify.annotations.Nullable Integer saltOverride) {
-        return !(this.frequency < 1.0F) || this.frequencyReductionMethod.shouldGenerate(levelSeed, this.salt, sourceX, sourceZ, this.frequency, saltOverride);
+        return this.applyAdditionalChunkRestrictions(sourceX, sourceZ, levelSeed, saltOverride, null);
+    }
+
+    public boolean applyAdditionalChunkRestrictions(final int sourceX, final int sourceZ, final long levelSeed, final @org.jspecify.annotations.Nullable Integer saltOverride, final net.minecraft.resources.@org.jspecify.annotations.Nullable ResourceKey<StructureSet> structureSetKey) {
+        final String effectiveKey = structureSetKey != null
+            ? structureSetKey.identifier().toString()
+            : this instanceof ChunkGeneratorStructureState.KeyedRandomSpreadStructurePlacement keyed ? keyed.seedShieldKey : null;
+        final boolean protectSeed = io.papermc.paper.configuration.Folia2b2tConfiguration.structureSeedProtectionEnabled() && effectiveKey != null;
+        final int placementSalt = protectSeed
+            ? io.papermc.paper.configuration.Folia2b2tConfiguration.protectedStructureSalt(levelSeed, effectiveKey, this.salt)
+            : this.salt;
+        final int frequencySalt = protectSeed
+            ? io.papermc.paper.configuration.Folia2b2tConfiguration.protectedStructureSalt(levelSeed, effectiveKey, saltOverride != null ? saltOverride : this.salt)
+            : (saltOverride != null ? saltOverride : this.salt);
+        final Integer frequencySaltOverride = protectSeed ? Integer.valueOf(frequencySalt) : saltOverride;
+        return !(this.frequency < 1.0F) || this.frequencyReductionMethod.shouldGenerate(levelSeed, placementSalt, sourceX, sourceZ, this.frequency, frequencySaltOverride);
         // Paper end - Add missing structure set seed configs
     }
 
@@ -143,11 +158,15 @@
     }
 
     private static boolean legacyPillagerOutpostReducer(final long seed, final int salt, final int sourceX, final int sourceZ, final float probability, final @org.jspecify.annotations.Nullable Integer saltOverride) { // Paper - Add missing structure set seed configs; ignore here
-        int cx = sourceX >> 4;
-        int cz = sourceZ >> 4;
-        WorldgenRandom random = new WorldgenRandom(new LegacyRandomSource(0L));
-        random.setSeed(cx ^ cz << 4 ^ seed);
-        random.nextInt();
+        WorldgenRandom random = new WorldgenRandom(new LegacyRandomSource(0L));
+        if (io.papermc.paper.configuration.Folia2b2tConfiguration.structureSeedProtectionEnabled() && saltOverride != null) {
+            random.setLargeFeatureWithSalt(seed, sourceX, sourceZ, saltOverride);
+        } else {
+            int cx = sourceX >> 4;
+            int cz = sourceZ >> 4;
+            random.setSeed(cx ^ cz << 4 ^ seed);
+            random.nextInt();
+        }
         return random.nextInt((int)(1.0F / probability)) == 0;
     }
 

     }
 
+    private ClientboundLightUpdatePacketData(ClientboundLightUpdatePacketData source) {
+        this.skyYMask = (BitSet)source.skyYMask.clone();
+        this.blockYMask = (BitSet)source.blockYMask.clone();
+        this.emptySkyYMask = (BitSet)source.emptySkyYMask.clone();
+        this.emptyBlockYMask = (BitSet)source.emptyBlockYMask.clone();
+        this.skyUpdates = source.skyUpdates.stream().map(byte[]::clone).collect(java.util.stream.Collectors.toCollection(java.util.ArrayList::new));
+        this.blockUpdates = source.blockUpdates.stream().map(byte[]::clone).collect(java.util.stream.Collectors.toCollection(java.util.ArrayList::new));
+    }
+
+    public ClientboundLightUpdatePacketData copyWithMask(java.util.function.IntPredicate visible, int minLightSection) {
+        ClientboundLightUpdatePacketData copy = new ClientboundLightUpdatePacketData(this);
+        mask(copy.skyYMask, copy.skyUpdates, visible, minLightSection);
+        mask(copy.blockYMask, copy.blockUpdates, visible, minLightSection);
+        return copy;
+    }
+
+    private static void mask(BitSet sections, List<byte[]> updates, java.util.function.IntPredicate visible, int minLightSection) {
+        int arrayIndex = 0;
+        for (int section = sections.nextSetBit(0); section >= 0; section = sections.nextSetBit(section + 1)) {
+            byte[] light = updates.get(arrayIndex++);
+            int bottom = (minLightSection + section) << 12;
+            for (int index = 0; index < 4096; index++) {
+                if (!visible.test(bottom | index)) {
+                    int byteIndex = index >> 1;
+                    light[byteIndex] = (byte)(light[byteIndex] & ((index & 1) == 0 ? 0xF0 : 0x0F));
+                }
+            }
+        }
+    }
+
     public void write(final FriendlyByteBuf output) {
         output.writeBitSet(this.skyYMask);
         output.writeBitSet(this.blockYMask);

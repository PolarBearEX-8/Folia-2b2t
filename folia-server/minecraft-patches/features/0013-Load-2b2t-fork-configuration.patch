From: Folia 2b2t Contributors <noreply@folia2b2t.dev>
Date: Tue, 8 Sep 2026 22:30:00 +0700
Subject: [PATCH] Load 2b2t fork configuration

Load config/2b2tfolia.yml at startup. Its Ender Pearl stasis settings control
whether the ticket is reapplied when a pearl enters the loaded state.

diff --git a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/server/ServerEntityLookup.java b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/server/ServerEntityLookup.java
index 38859590db0fbd1250a361fe954114007b347733..9999428f00177d89243b7a73d87d6f9b77bfa1e1 100644
--- a/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/server/ServerEntityLookup.java
+++ b/ca/spottedleaf/moonrise/patches/chunk_system/level/entity/server/ServerEntityLookup.java
@@ -113,7 +113,7 @@ public final class ServerEntityLookup extends EntityLookup {
         // the same pearl-specific ticket after a loaded-state transition as well: the ticket
         // set de-duplicates this identifier, and this closes a transition window where the
         // entity becomes visible again after its original ticket operation was superseded.
-        if (entity instanceof ThrownEnderpearl enderpearl) {
+        if (io.papermc.paper.configuration.Folia2b2tConfiguration.reapplyEnderPearlTicketOnLoadedTransition() && entity instanceof ThrownEnderpearl enderpearl) {
             this.addEnderPearl(CoordinateUtils.getChunkKey(enderpearl.chunkPosition()), enderpearl.getId());
         }
         // Moonrise start - entity tracker
diff --git a/io/papermc/paper/configuration/Folia2b2tConfiguration.java b/io/papermc/paper/configuration/Folia2b2tConfiguration.java
new file mode 100644
index 0000000000000000000000000000000000000000..3363d44126072598c15f11ac4f648cf9957902a9
--- /dev/null
+++ b/io/papermc/paper/configuration/Folia2b2tConfiguration.java
@@ -0,0 +1,34 @@
+package io.papermc.paper.configuration;
+
+import java.io.File;
+import org.bukkit.configuration.file.YamlConfiguration;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** Configuration owned by the Folia 2b2t fork. */
+public final class Folia2b2tConfiguration {
+
+    private static final Logger LOGGER = LoggerFactory.getLogger("Folia2b2tConfig");
+    private static final File FILE = new File("config", "2b2tfolia.yml");
+    private static volatile boolean reapplyEnderPearlTicketOnLoadedTransition = true;
+
+    private Folia2b2tConfiguration() {
+    }
+
+    public static void load() {
+        if (!FILE.isFile()) {
+            LOGGER.warn("{} was not found; using the default Ender Pearl stasis settings", FILE.getPath());
+            return;
+        }
+
+        final YamlConfiguration configuration = YamlConfiguration.loadConfiguration(FILE);
+        final boolean enabled = configuration.getBoolean("ender-pearl-stasis.enabled", true);
+        reapplyEnderPearlTicketOnLoadedTransition = enabled
+            && configuration.getBoolean("ender-pearl-stasis.reapply-ticket-on-loaded-transition", true);
+        LOGGER.info("Loaded {} (ender-pearl-stasis reapply-ticket-on-loaded-transition: {})", FILE.getPath(), reapplyEnderPearlTicketOnLoadedTransition);
+    }
+
+    public static boolean reapplyEnderPearlTicketOnLoadedTransition() {
+        return reapplyEnderPearlTicketOnLoadedTransition;
+    }
+}

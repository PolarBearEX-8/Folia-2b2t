+++ b/src/main/java/io/papermc/paper/antixray/CavePlayerState.java
@@ -0,0 +1,43 @@
+package io.papermc.paper.antixray;
+
+import java.util.BitSet;
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/** Connection-owned state; does not retain players after disconnect. Masks are immutable once published. */
+public final class CavePlayerState {
+    ChunkPacketBlockControllerCave controller;
+    final Map<Long, View> sent = new ConcurrentHashMap<>();
+    final it.unimi.dsi.fastutil.ints.IntOpenHashSet trackedEntities = new it.unimi.dsi.fastutil.ints.IntOpenHashSet();
+    final java.util.ArrayDeque<Long> pending = new java.util.ArrayDeque<>();
+    final java.util.HashSet<Long> queued = new java.util.HashSet<>();
+    volatile Map<Long, BitSet> nearby = Map.of();
+    int ticks;
+    int lastX = Integer.MIN_VALUE;
+    int lastY;
+    int lastZ;
+
+    synchronized void reset(ChunkPacketBlockControllerCave controller) {
+        if (this.controller == controller) return;
+        clear();
+        this.controller = controller;
+    }
+
+    public synchronized void clear() {
+        this.sent.clear();
+        this.trackedEntities.clear();
+        this.pending.clear();
+        this.queued.clear();
+        this.nearby = Map.of();
+        this.controller = null;
+        this.ticks = 0;
+        this.lastX = Integer.MIN_VALUE;
+    }
+
+    void queue(long key) {
+        if (this.queued.add(key)) this.pending.addLast(key);
+    }
+
+    record View(BitSet cells, boolean bypass, long revision) {
+    }
+}
diff --git a/src/main/java/io/papermc/paper/antixray/CaveVisibility.java b/src/main/java/io/papermc/paper/antixray/CaveVisibility.java
new file mode 100644
index 000000000..6e14eff14
--- /dev/null
+++ b/src/main/java/io/papermc/paper/antixray/CaveVisibility.java
@@ -0,0 +1,125 @@
+package io.papermc.paper.antixray;
+
+import java.util.BitSet;
+
+/** Bounded, six-connected flood fill over an immutable voxel snapshot. */
+final class CaveVisibility {
+    private CaveVisibility() {
+    }
+
+    static boolean anySet(long[] words, int start, int end) {
+        if (start >= end || (start >>> 6) >= words.length) return false;
+        int word = start >>> 6;
+        int shift = start & 63;
+        int length = end - start; // Callers query at most four adjacent voxels.
+        long bits = words[word] >>> shift;
+        if (shift + length > 64 && word + 1 < words.length) bits |= words[word + 1] << (64 - shift);
+        return (bits & ((1L << length) - 1)) != 0;
+    }
+
+    static BitSet projectToChunk(BitSet visited, int baseX, int baseY, int baseZ, int width, int height, int depth,
+                                int minY, int maxY, int chunkMinX, int chunkMinZ) {
+        long[] words = visited.toLongArray();
+        BitSet cells = new BitSet();
+        int lowX = Math.max(Math.floorDiv(baseX, 4) * 4, chunkMinX - 4);
+        int highX = Math.min(baseX + width, chunkMinX + 20);
+        int lowZ = Math.max(Math.floorDiv(baseZ, 4) * 4, chunkMinZ - 4);
+        int highZ = Math.min(baseZ + depth, chunkMinZ + 20);
+        for (int y = Math.max(Math.floorDiv(baseY, 4) * 4, minY - 4); y < Math.min(baseY + height, maxY + 4); y += 4) {
+            for (int z = lowZ; z < highZ; z += 4) {
+                for (int x = lowX; x < highX; x += 4) {
+                    boolean found = false;
+                    for (int by = Math.max(y, baseY); by < Math.min(y + 4, baseY + height) && !found; by++) {
+                        for (int bz = Math.max(z, baseZ); bz < Math.min(z + 4, baseZ + depth); bz++) {
+                            int start = ((by - baseY) * depth + bz - baseZ) * width + Math.max(x, baseX) - baseX;
+                            int end = start + Math.min(x + 4, baseX + width) - Math.max(x, baseX);
+                            if (anySet(words, start, end)) { found = true; break; }
+                        }
+                    }
+                    if (!found) continue;
+                    mark(cells, x, y, z, minY, maxY, chunkMinX, chunkMinZ);
+                    mark(cells, x - 4, y, z, minY, maxY, chunkMinX, chunkMinZ);
+                    mark(cells, x + 4, y, z, minY, maxY, chunkMinX, chunkMinZ);
+                    mark(cells, x, y - 4, z, minY, maxY, chunkMinX, chunkMinZ);
+                    mark(cells, x, y + 4, z, minY, maxY, chunkMinX, chunkMinZ);
+                    mark(cells, x, y, z - 4, minY, maxY, chunkMinX, chunkMinZ);
+                    mark(cells, x, y, z + 4, minY, maxY, chunkMinX, chunkMinZ);
+                }
+            }
+        }
+        return cells;
+    }
+
+    private static void mark(BitSet cells, int x, int y, int z, int minY, int maxY, int chunkMinX, int chunkMinZ) {
+        if (x >= chunkMinX && x < chunkMinX + 16 && z >= chunkMinZ && z < chunkMinZ + 16 && y >= minY && y < maxY) {
+            cells.set(cellIndex(x, y, z, minY));
+        }
+    }
+
+    static BitSet exterior(BitSet open, BitSet sky, int width, int height, int depth, int distance) {
+        BitSet caves = (BitSet)open.clone();
+        caves.andNot(sky);
+        BitSet seeds = new BitSet();
+        int layer = width * depth;
+        for (int index = caves.nextSetBit(0); index >= 0; index = caves.nextSetBit(index + 1)) {
+            int x = index % width;
+            int z = (index / width) % depth;
+            int y = index / layer;
+            if ((x > 0 && sky.get(index - 1)) || (x + 1 < width && sky.get(index + 1))
+                || (z > 0 && sky.get(index - width)) || (z + 1 < depth && sky.get(index + width))
+                || (y > 0 && sky.get(index - layer)) || (y + 1 < height && sky.get(index + layer))) seeds.set(index);
+        }
+        BitSet result = (BitSet)sky.clone();
+        if (distance > 0) result.or(flood(caves, seeds, width, height, depth, distance - 1, width * height * depth));
+        return result;
+    }
+
+    static BitSet flood(BitSet open, BitSet seeds, int width, int height, int depth, int distance, int budget) {
+        int size = Math.multiplyExact(Math.multiplyExact(width, height), depth);
+        int capacity = Math.min(size, budget);
+        int[] queue = new int[capacity];
+        byte[] distances = new byte[size];
+        BitSet visited = new BitSet(size);
+        int tail = 0;
+        for (int index = seeds.nextSetBit(0); index >= 0 && index < size && tail < capacity; index = seeds.nextSetBit(index + 1)) {
+            if (open.get(index)) {
+                visited.set(index);
+                queue[tail++] = index;
+            }
+        }
+        int layer = width * depth;
+        for (int head = 0; head < tail; head++) {
+            int index = queue[head];
+            int step = Byte.toUnsignedInt(distances[index]);
+            if (step >= distance) continue;
+            int x = index % width;
+            int z = (index / width) % depth;
+            int y = index / layer;
+            for (int direction = 0; direction < 6; direction++) {
+                int next;
+                switch (direction) {
+                    case 0 -> { if (x == 0) continue; next = index - 1; }
+                    case 1 -> { if (x + 1 == width) continue; next = index + 1; }
+                    case 2 -> { if (z == 0) continue; next = index - width; }
+                    case 3 -> { if (z + 1 == depth) continue; next = index + width; }
+                    case 4 -> { if (y == 0) continue; next = index - layer; }
+                    default -> { if (y + 1 == height) continue; next = index + layer; }
+                }
+                if (tail < capacity && open.get(next) && !visited.get(next)) {
+                    visited.set(next);
+                    distances[next] = (byte)(step + 1);
+                    queue[tail++] = next;
+                }
+            }
+        }
+        return visited;
+    }
+
+    static int cellIndex(int x, int y, int z, int minY) {
+        return ((y - minY) >> 2) * 16 + ((z & 15) >> 2) * 4 + ((x & 15) >> 2);
+    }
+
+    static boolean visible(BitSet cells, int x, int y, int z, int minY, int maxY) {
+        return y < minY || y >= maxY || cells.get(cellIndex(x, y, z, minY));
+    }
+}

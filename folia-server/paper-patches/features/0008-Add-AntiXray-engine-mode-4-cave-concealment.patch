@@ -0,0 +1,135 @@
+package io.papermc.paper.antixray;
+
+import it.unimi.dsi.fastutil.ints.IntArrayList;
+import java.util.Optional;
+import net.minecraft.core.BlockPos;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.game.ClientboundAddEntityPacket;
+import net.minecraft.network.protocol.game.ClientboundAnimatePacket;
+import net.minecraft.network.protocol.game.ClientboundDamageEventPacket;
+import net.minecraft.network.protocol.game.ClientboundDebugBlockValuePacket;
+import net.minecraft.network.protocol.game.ClientboundDebugEntityValuePacket;
+import net.minecraft.network.protocol.game.ClientboundEntityEventPacket;
+import net.minecraft.network.protocol.game.ClientboundEntityPositionSyncPacket;
+import net.minecraft.network.protocol.game.ClientboundExplodePacket;
+import net.minecraft.network.protocol.game.ClientboundHurtAnimationPacket;
+import net.minecraft.network.protocol.game.ClientboundLevelParticlesPacket;
+import net.minecraft.network.protocol.game.ClientboundMoveEntityPacket;
+import net.minecraft.network.protocol.game.ClientboundRemoveEntitiesPacket;
+import net.minecraft.network.protocol.game.ClientboundRemoveMobEffectPacket;
+import net.minecraft.network.protocol.game.ClientboundRotateHeadPacket;
+import net.minecraft.network.protocol.game.ClientboundSetEntityDataPacket;
+import net.minecraft.network.protocol.game.ClientboundSetEntityLinkPacket;
+import net.minecraft.network.protocol.game.ClientboundSetEntityMotionPacket;
+import net.minecraft.network.protocol.game.ClientboundSetEquipmentPacket;
+import net.minecraft.network.protocol.game.ClientboundSetPassengersPacket;
+import net.minecraft.network.protocol.game.ClientboundSoundEntityPacket;
+import net.minecraft.network.protocol.game.ClientboundSoundPacket;
+import net.minecraft.network.protocol.game.ClientboundTakeItemEntityPacket;
+import net.minecraft.network.protocol.game.ClientboundTeleportEntityPacket;
+import net.minecraft.network.protocol.game.ClientboundUpdateAttributesPacket;
+import net.minecraft.network.protocol.game.ClientboundUpdateMobEffectPacket;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.phys.Vec3;
+
+/** Filters only published masks and known IDs. Never looks up world entities or recalculates visibility. */
+final class CaveEffectFilter {
+    private CaveEffectFilter() {
+    }
+
+    static boolean protectedEntity(ServerPlayer player, int id) {
+        if (id == player.getId()) return true;
+        Entity root = player.getRootVehicle();
+        if (root != null && root.getId() == id) return true;
+        Entity camera = player.getCamera();
+        return camera != null && camera.getId() == id;
+    }
+
+    private static boolean known(CavePlayerState state, ServerPlayer player, int id) {
+        return state.trackedEntities.contains(id) || protectedEntity(player, id);
+    }
+
+    private static boolean visible(ChunkPacketBlockControllerCave controller, CavePlayerState state, double x, double y, double z) {
+        return Double.isFinite(x) && Double.isFinite(y) && Double.isFinite(z)
+            && controller.visible(state, BlockPos.containing(x, y, z));
+    }
+
+    static Packet<?> filter(ChunkPacketBlockControllerCave controller, ServerPlayer player, Packet<?> packet,
+                            CavePlayerState state, boolean bypass) {
+        if (packet instanceof ClientboundRemoveEntitiesPacket removed) {
+            for (int id : removed.getEntityIds()) state.trackedEntities.remove(id);
+            return packet; // Always allow cleanup, including after a chunk unload or a hide transition.
+        }
+        if (packet instanceof ClientboundAddEntityPacket spawn) {
+            if (bypass || protectedEntity(player, spawn.getId()) || visible(controller, state, spawn.getX(), spawn.getY(), spawn.getZ())) {
+                state.trackedEntities.add(spawn.getId());
+                return packet;
+            }
+            return null;
+        }
+        if (bypass) return packet;
+        if (packet instanceof ClientboundLevelParticlesPacket particles) {
+            return visible(controller, state, particles.getX(), particles.getY(), particles.getZ()) ? packet : null;
+        }
+        if (packet instanceof ClientboundSoundPacket sound) {
+            return visible(controller, state, sound.getX(), sound.getY(), sound.getZ()) ? packet : null;
+        }
+        if (packet instanceof ClientboundExplodePacket explosion) {
+            // Explosion packets also carry client physics: never discard knockback affecting this player.
+            return explosion.playerKnockback().isPresent()
+                || visible(controller, state, explosion.center().x, explosion.center().y, explosion.center().z) ? packet : null;
+        }
+        if (packet instanceof ClientboundDebugBlockValuePacket debug) {
+            return controller.visible(state, debug.blockPos()) ? packet : null;
+        }
+        if (packet instanceof ClientboundTakeItemEntityPacket pickup) {
+            return known(state, player, pickup.getItemId()) && known(state, player, pickup.getPlayerId()) ? packet : null;
+        }
+        if (packet instanceof ClientboundSetEntityLinkPacket link) {
+            return known(state, player, link.getSourceId()) && (link.getDestId() == 0 || known(state, player, link.getDestId())) ? packet : null;
+        }
+        if (packet instanceof ClientboundSetPassengersPacket passengers) {
+            if (!known(state, player, passengers.getVehicle())) return null;
+            IntArrayList allowed = null;
+            int[] ids = passengers.getPassengers();
+            for (int i = 0; i < ids.length; i++) {
+                if (known(state, player, ids[i])) {
+                    if (allowed != null) allowed.add(ids[i]);
+                } else if (allowed == null) {
+                    allowed = new IntArrayList(ids.length);
+                    for (int previous = 0; previous < i; previous++) allowed.add(ids[previous]);
+                }
+            }
+            return allowed == null ? packet : new ClientboundSetPassengersPacket(passengers.getVehicle(), allowed.toIntArray());
+        }
+        if (packet instanceof ClientboundDamageEventPacket damage) {
+            if (!known(state, player, damage.entityId())) return null;
+            int cause = known(state, player, damage.sourceCauseId()) ? damage.sourceCauseId() : -1;
+            int direct = known(state, player, damage.sourceDirectId()) ? damage.sourceDirectId() : -1;
+            Optional<Vec3> position = damage.sourcePosition().filter(pos -> visible(controller, state, pos.x, pos.y, pos.z));
+            if (cause == damage.sourceCauseId() && direct == damage.sourceDirectId() && position.equals(damage.sourcePosition())) return packet;
+            return new ClientboundDamageEventPacket(damage.entityId(), damage.sourceType(), cause, direct, position);
+        }
+
+        int target = switch (packet) {
+            case ClientboundSetEntityDataPacket value -> value.id();
+            case ClientboundSetEntityMotionPacket value -> value.id();
+            case ClientboundEntityPositionSyncPacket value -> value.id();
+            case ClientboundTeleportEntityPacket value -> value.id();
+            case ClientboundMoveEntityPacket value -> value.getEntityId();
+            case ClientboundRotateHeadPacket value -> value.getEntityId();
+            case ClientboundEntityEventPacket value -> value.getEntityId();
+            case ClientboundAnimatePacket value -> value.getId();
+            case ClientboundHurtAnimationPacket value -> value.id();
+            case ClientboundSetEquipmentPacket value -> value.getEntity();
+            case ClientboundUpdateAttributesPacket value -> value.getEntityId();
+            case ClientboundUpdateMobEffectPacket value -> value.getEntityId();
+            case ClientboundRemoveMobEffectPacket value -> value.entityId();
+            case ClientboundSoundEntityPacket value -> value.getId();
+            case ClientboundDebugEntityValuePacket value -> value.entityId();
+            default -> Integer.MIN_VALUE;
+        };
+        return target == Integer.MIN_VALUE || known(state, player, target) ? packet : null;
+    }
+}
diff --git a/src/main/java/io/papermc/paper/antixray/CavePlayerState.java b/src/main/java/io/papermc/paper/antixray/CavePlayerState.java
new file mode 100644

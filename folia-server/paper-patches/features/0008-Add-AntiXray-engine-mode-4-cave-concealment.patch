+import net.minecraft.world.level.Level;
+import net.minecraft.world.phys.Vec3;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+@VanillaFeature
+class CaveEffectsTest {
+    private ChunkPacketBlockControllerCave controller;
+    private ServerPlayer player;
+    private CavePlayerState state;
+    private static final BlockPos HIDDEN = new BlockPos(4, 8, 4);
+    private static final BlockPos VISIBLE = new BlockPos(4, 24, 4);
+
+    @BeforeEach
+    void setup() {
+        Level level = mock(Level.class);
+        when(level.getMinY()).thenReturn(0);
+        when(level.getMaxY()).thenReturn(31);
+        this.controller = new ChunkPacketBlockControllerCave(level, 32, false);
+        this.player = mock(ServerPlayer.class);
+        when(this.player.getId()).thenReturn(1);
+        when(this.player.getRootVehicle()).thenReturn(this.player);
+        when(this.player.getCamera()).thenReturn(this.player);
+        this.state = new CavePlayerState();
+        this.state.reset(this.controller);
+        BitSet cells = new BitSet();
+        cells.set(CaveVisibility.cellIndex(4, 24, 4, 0));
+        this.state.sent.put(0L, new CavePlayerState.View(cells, false, 0L));
+    }
+
+    private Packet<?> filter(Packet<?> packet) {
+        return this.controller.filterPacket(this.player, packet, this.state);
+    }
+
+    private ClientboundAddEntityPacket spawn(int id, BlockPos pos) {
+        return new ClientboundAddEntityPacket(id, UUID.randomUUID(), pos.getX() + 0.5, pos.getY(), pos.getZ() + 0.5,
+            0, 0, EntityTypes.ITEM, 0, Vec3.ZERO, 0);
+    }
+
+    private ClientboundLevelParticlesPacket particle(BlockPos pos) {
+        return new ClientboundLevelParticlesPacket(ParticleTypes.POOF, false, false,
+            pos.getX() + 0.5, pos.getY(), pos.getZ() + 0.5, 0, 0, 0, 0, 10);
+    }
+
+    @Test
+    void hiddenItemSpawnBundleAndMetadataAreDroppedTogether() {
+        ClientboundBundlePacket bundle = new ClientboundBundlePacket(List.of(spawn(99, HIDDEN),
+            new ClientboundSetEntityDataPacket(99, List.of()), new ClientboundSetEntityMotionPacket(99, Vec3.ZERO)));
+        assertNull(filter(bundle));
+        assertFalse(this.state.trackedEntities.contains(99));
+    }
+
+    @Test
+    void visibleItemSpawnRegistersBeforeBundledMetadataAndMovement() {
+        ClientboundBundlePacket bundle = new ClientboundBundlePacket(List.of(spawn(99, VISIBLE),
+            new ClientboundSetEntityDataPacket(99, List.of()), new ClientboundSetEntityMotionPacket(99, Vec3.ZERO)));
+        ClientboundBundlePacket filtered = (ClientboundBundlePacket)filter(bundle);
+        java.util.List<Packet<?>> packets = new java.util.ArrayList<>();
+        filtered.subPackets().forEach(packets::add);
+        assertEquals(3, packets.size());
+        assertTrue(this.state.trackedEntities.contains(99));
+    }
+
+    @Test
+    void entityTrackingChangesOnlyWhenSentMaskRevealsItsCell() {
+        Entity item = mock(net.minecraft.world.entity.item.ItemEntity.class);
+        when(item.getId()).thenReturn(99);
+        when(item.blockPosition()).thenReturn(HIDDEN);
+        assertFalse(this.controller.shouldTrackEntity(this.player, item, this.state));
+        BitSet cells = (BitSet)this.state.sent.get(0L).cells().clone();
+        cells.set(CaveVisibility.cellIndex(4, 8, 4, 0));
+        this.state.sent.put(0L, new CavePlayerState.View(cells, false, 0));
+        assertTrue(this.controller.shouldTrackEntity(this.player, item, this.state));
+        assertNotNull(filter(spawn(99, HIDDEN)));
+        when(item.blockPosition()).thenReturn(new BlockPos(12, 8, 12));
+        assertFalse(this.controller.shouldTrackEntity(this.player, item, this.state));
+    }
+
+    @Test
+    void removeAllowsRePairingAndClearsMetadataAndSoundPermission() {
+        filter(spawn(99, VISIBLE));
+        assertNotNull(filter(new ClientboundSetEntityDataPacket(99, List.of())));
+        ClientboundRemoveEntitiesPacket removal = new ClientboundRemoveEntitiesPacket(99);
+        assertSame(removal, filter(removal));
+        assertNull(filter(new ClientboundSetEntityDataPacket(99, List.of())));
+        assertNotNull(filter(spawn(99, VISIBLE)));
+    }
+
+    @Test
+    void particleAndPositionalSoundsFollowTheirOriginCell() {
+        assertNull(filter(particle(HIDDEN)));
+        var visible = particle(VISIBLE);
+        assertSame(visible, filter(visible));
+        var hiddenSound = new ClientboundSoundPacket(Holder.direct(SoundEvents.ITEM_PICKUP), SoundSource.BLOCKS, 4.5, 8, 4.5, 1, 1, 0);
+        var visibleSound = new ClientboundSoundPacket(Holder.direct(SoundEvents.ITEM_PICKUP), SoundSource.BLOCKS, 4.5, 24, 4.5, 1, 1, 0);
+        assertNull(filter(hiddenSound));
+        assertSame(visibleSound, filter(visibleSound));
+    }
+
+    @Test
+    void entitySoundsAndPickupAnimationCannotReferenceUnseenEntities() {
+        Entity item = mock(Entity.class); when(item.getId()).thenReturn(99);
+        var sound = new ClientboundSoundEntityPacket(Holder.direct(SoundEvents.ITEM_PICKUP), SoundSource.NEUTRAL, item, 1, 1, 0);
+        var pickup = new ClientboundTakeItemEntityPacket(99, 1, 1);
+        assertNull(filter(sound)); assertNull(filter(pickup));
+        filter(spawn(99, VISIBLE));
+        assertSame(sound, filter(sound)); assertSame(pickup, filter(pickup));
+        assertNull(filter(new ClientboundTakeItemEntityPacket(99, 100, 1)));
+    }
+
+    @Test
+    void unseenEntityMovementAndEffectsAreSuppressedButOwnPhysicsRemain() {
+        var movement = new ClientboundMoveEntityPacket.Pos(99, (short)1, (short)2, (short)3, false);
+        var position = new ClientboundEntityPositionSyncPacket(99, new PositionMoveRotation(Vec3.ZERO, Vec3.ZERO, 0, 0), false);
+        assertNull(filter(movement)); assertNull(filter(position));
+        assertNull(filter(new ClientboundHurtAnimationPacket(99, 30)));
+        var ownVelocity = new ClientboundSetEntityMotionPacket(1, new Vec3(0, 1, 0));
+        assertSame(ownVelocity, filter(ownVelocity));
+        filter(spawn(99, VISIBLE));
+        assertSame(movement, filter(movement)); assertSame(position, filter(position));
+    }
+
+    @Test
+    void hiddenPassengerIdsAreRemovedWithoutDroppingTheVehicleUpdate() {
+        filter(spawn(20, VISIBLE));
+        var passengers = new ClientboundSetPassengersPacket(20, new int[]{1, 99});
+        var filtered = (ClientboundSetPassengersPacket)filter(passengers);
+        assertArrayEquals(new int[]{1}, filtered.getPassengers());
+        assertArrayEquals(new int[]{1, 99}, passengers.getPassengers());
+        assertNull(filter(new ClientboundSetPassengersPacket(99, new int[]{1})));
+    }
+
+    @Test
+    void ownDamageNotificationPreservesDamageButRedactsHiddenAttackerPosition() {
+        var damage = new ClientboundDamageEventPacket(1, Holder.direct(new DamageType("test", 0)), 99, 100,
+            Optional.of(new Vec3(4.5, 8, 4.5)));
+        var filtered = (ClientboundDamageEventPacket)filter(damage);
+        assertEquals(1, filtered.entityId());
+        assertEquals(-1, filtered.sourceCauseId()); assertEquals(-1, filtered.sourceDirectId());
+        assertTrue(filtered.sourcePosition().isEmpty());
+        assertSame(damage.sourceType(), filtered.sourceType());
+    }
+
+    @Test
+    void explosionVisualsAreHiddenButPlayerKnockbackIsNotDiscarded() {
+        var hidden = new ClientboundExplodePacket(new Vec3(4.5, 8, 4.5), 4, 0, Optional.empty(),
+            ParticleTypes.EXPLOSION, SoundEvents.GENERIC_EXPLODE, WeightedList.of());
+        assertNull(filter(hidden));
+        var affectsPlayer = new ClientboundExplodePacket(hidden.center(), 4, 0, Optional.of(new Vec3(0, 1, 0)),
+            ParticleTypes.EXPLOSION, SoundEvents.GENERIC_EXPLODE, WeightedList.of());
+        assertSame(affectsPlayer, filter(affectsPlayer));
+    }
+
+    @Test
+    void vehicleAndCameraAreNeverRemovedFromTheirControllingPlayer() {
+        Entity vehicle = mock(Entity.class); when(vehicle.getId()).thenReturn(99);
+        when(vehicle.blockPosition()).thenReturn(HIDDEN);
+        when(this.player.getRootVehicle()).thenReturn(vehicle);
+        assertTrue(this.controller.shouldTrackEntity(this.player, vehicle, this.state));
+        assertNotNull(filter(spawn(99, HIDDEN)));
+        Entity camera = mock(Entity.class); when(camera.getId()).thenReturn(100);
+        when(this.player.getCamera()).thenReturn(camera);
+        assertTrue(this.controller.shouldTrackEntity(this.player, camera, this.state));
+    }
+
+    @Test
+    void debugUpdatesAndStateResetDoNotLeakHiddenIds() {
+        var hiddenBlock = new ClientboundDebugBlockValuePacket(HIDDEN, DebugSubscriptions.POIS.emptyUpdate());
+        var hiddenEntity = new ClientboundDebugEntityValuePacket(99, DebugSubscriptions.ENTITY_PATHS.emptyUpdate());
+        assertNull(filter(hiddenBlock)); assertNull(filter(hiddenEntity));
+        filter(spawn(99, VISIBLE));
+        assertSame(hiddenEntity, filter(hiddenEntity));
+        this.state.clear();
+        assertTrue(this.state.trackedEntities.isEmpty());
+        assertNull(filter(new ClientboundSetEntityDataPacket(99, List.of())));
+    }
+
+    @Test
+    void bypassAllowsEffectsWhileStillMaintainingEntityCleanup() {
+        var particle = particle(HIDDEN);
+        assertSame(particle, CaveEffectFilter.filter(this.controller, this.player, particle, this.state, true));
+        var spawn = spawn(99, HIDDEN);
+        assertSame(spawn, CaveEffectFilter.filter(this.controller, this.player, spawn, this.state, true));
+        assertTrue(this.state.trackedEntities.contains(99));
+        CaveEffectFilter.filter(this.controller, this.player, new ClientboundRemoveEntitiesPacket(99), this.state, true);
+        assertTrue(this.state.trackedEntities.isEmpty());
+    }
+}

+    @Test
+    void refreshQueueIsLimitedToTwoChunksPerPlayerTick() throws ReflectiveOperationException {
+        CavePlayerState state = new CavePlayerState();
+        state.reset(this.controller);
+        net.minecraft.server.network.ServerGamePacketListenerImpl connection = mock(net.minecraft.server.network.ServerGamePacketListenerImpl.class);
+        java.lang.reflect.Field connectionState = net.minecraft.server.network.ServerGamePacketListenerImpl.class.getField("caveVisibility");
+        connectionState.setAccessible(true);
+        connectionState.set(connection, state);
+        this.player.connection = connection;
+        when(this.player.getDeltaMovement()).thenReturn(net.minecraft.world.phys.Vec3.ZERO);
+        java.lang.reflect.Field blockController = Level.class.getField("chunkPacketBlockController");
+        blockController.setAccessible(true);
+        blockController.set(this.level, this.controller);
+        when(this.chunk.getLevel()).thenReturn(this.level);
+        var loader = mock(ca.spottedleaf.moonrise.patches.chunk_system.player.RegionizedPlayerChunkLoader.PlayerChunkLoaderData.class);
+        when(this.player.moonrise$getChunkLoader()).thenReturn(loader);
+        var sent = new it.unimi.dsi.fastutil.longs.LongOpenHashSet();
+        for (int x = 0; x < 3; x++) {
+            LevelChunk next = mock(LevelChunk.class);
+            when(next.getLevel()).thenReturn(this.level);
+            when(next.getPos()).thenReturn(new ChunkPos(x, 0));
+            when(next.getSections()).thenReturn(this.sections);
+            when(next.getHeightmaps()).thenReturn(List.of());
+            when(next.getBlockEntities()).thenReturn(Map.of());
+            when(this.level.getChunkIfLoaded(x, 0)).thenReturn(next);
+            long key = ChunkPos.pack(x, 0);

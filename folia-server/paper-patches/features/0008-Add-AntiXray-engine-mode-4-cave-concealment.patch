+package io.papermc.paper.antixray;
+
+import io.netty.buffer.Unpooled;
+import java.util.BitSet;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.SectionPos;
+import net.minecraft.network.FriendlyByteBuf;
+import net.minecraft.network.protocol.game.*;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.chunk.PalettedContainer;
+import net.minecraft.world.level.chunk.PalettedContainerFactory;
+import net.minecraft.world.level.dimension.DimensionType;
+import net.minecraft.world.level.lighting.LevelLightEngine;
+import org.bukkit.World;
+import org.bukkit.support.RegistryHelper;
+import org.bukkit.support.environment.VanillaFeature;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import static org.mockito.ArgumentMatchers.*;
+import static org.mockito.Mockito.*;
+
+@VanillaFeature
+class CavePacketTest {
+    private Level level;
+    private LevelChunk chunk;
+    private LevelChunkSection[] sections;
+    private PalettedContainerFactory factory;
+    private ServerPlayer player;
+    private ChunkPacketBlockControllerCave controller;
+    private ClientboundLevelChunkWithLightPacket original;
+    private ClientboundLightUpdatePacketData light;
+
+    @BeforeEach
+    void setup() {
+        this.factory = PalettedContainerFactory.create(RegistryHelper.registryAccess());
+        this.sections = new LevelChunkSection[2];
+        for (int i = 0; i < 2; i++) {
+            this.sections[i] = new LevelChunkSection(new PalettedContainer<>(Blocks.STONE.defaultBlockState(),
+                this.factory.blockStatesStrategy(), null), this.factory.createForBiomes());
+        }
+        for (int y = 20; y < 32; y++) for (int z = 0; z < 16; z++) for (int x = 0; x < 16; x++) {
+            this.sections[1].setBlockState(x, y & 15, z, Blocks.AIR.defaultBlockState());
+        }
+        this.sections[0].setBlockState(4, 8, 4, Blocks.CAVE_AIR.defaultBlockState());
+        this.sections[0].setBlockState(5, 8, 4, Blocks.AIR.defaultBlockState());
+        this.sections[0].setBlockState(6, 8, 4, Blocks.DIAMOND_ORE.defaultBlockState());
+        this.level = mock(Level.class);
+        when(this.level.getMinY()).thenReturn(0);
+        when(this.level.getHeight()).thenReturn(32);
+        when(this.level.getMaxY()).thenReturn(31);
+        DimensionType dimension = mock(DimensionType.class);
+        when(dimension.hasSkyLight()).thenReturn(true);
+        when(this.level.dimensionType()).thenReturn(dimension);
+        org.bukkit.craftbukkit.CraftWorld world = mock(org.bukkit.craftbukkit.CraftWorld.class);
+        when(world.getEnvironment()).thenReturn(World.Environment.NORMAL);
+        when(this.level.getWorld()).thenReturn(world);
+        LevelLightEngine engine = mock(LevelLightEngine.class);
+        when(engine.getMinLightSection()).thenReturn(0);
+        when(this.level.getLightEngine()).thenReturn(engine);
+        this.chunk = mock(LevelChunk.class);
+        when(this.chunk.getPos()).thenReturn(new ChunkPos(0, 0));
+        when(this.chunk.getSections()).thenReturn(this.sections);
+        when(this.chunk.getHeightmaps()).thenReturn(List.of());
+        when(this.chunk.getBlockEntities()).thenReturn(Map.of());
+        when(this.level.getChunkIfLoaded(anyInt(), anyInt())).thenReturn(null);
+        when(this.level.getChunkIfLoaded(0, 0)).thenReturn(this.chunk);
+        this.player = mock(ServerPlayer.class);
+        when(this.player.blockPosition()).thenReturn(new BlockPos(1024, 100, 1024));
+        this.controller = new ChunkPacketBlockControllerCave(this.level, 32, false);
+        this.light = light();
+        this.original = mock(ClientboundLevelChunkWithLightPacket.class);
+        when(this.original.getX()).thenReturn(0);
+        when(this.original.getZ()).thenReturn(0);
+        when(this.original.getLightData()).thenReturn(this.light);
+    }
+
+    private static ClientboundLightUpdatePacketData light() {
+        FriendlyByteBuf buffer = new FriendlyByteBuf(Unpooled.buffer());
+        try {
+            BitSet full = new BitSet(); full.set(0, 2);
+            buffer.writeBitSet(full); buffer.writeBitSet(full);
+            buffer.writeBitSet(new BitSet()); buffer.writeBitSet(new BitSet());
+            byte[] data = new byte[2048]; java.util.Arrays.fill(data, (byte)0xFF);
+            for (int layer = 0; layer < 2; layer++) {
+                buffer.writeVarInt(2);
+                buffer.writeByteArray(data); buffer.writeByteArray(data);
+            }
+            return new ClientboundLightUpdatePacketData(buffer, 0, 0);
+        } finally {
+            buffer.release();
+        }
+    }
+
+    private LevelChunkSection readSection(ClientboundLevelChunkWithLightPacket packet, int index) {
+        FriendlyByteBuf buffer = packet.getChunkData().getReadBuffer();
+        try {
+            LevelChunkSection section = null;
+            for (int i = 0; i <= index; i++) {
+                section = new LevelChunkSection(this.factory, null, null, 0);
+                section.read(buffer);
+            }
+            return section;
+        } finally {
+            buffer.release();
+        }
+    }
+
+    @Test
+    void bothKindsOfAirAndOreBecomeSolidWithoutChangingWorldOrBiomes() {
+        CavePlayerState state = new CavePlayerState();
+        ClientboundLevelChunkWithLightPacket packet = (ClientboundLevelChunkWithLightPacket)this.controller.filterPacket(this.player, this.original, state);
+        LevelChunkSection hidden = readSection(packet, 0);
+        assertTrue(packet.isReady());
+        assertFalse(hidden.hasOnlyAir());
+        assertEquals(Blocks.STONE.defaultBlockState(), hidden.getBlockState(4, 8, 4));
+        assertEquals(Blocks.STONE.defaultBlockState(), hidden.getBlockState(5, 8, 4));
+        assertEquals(Blocks.STONE.defaultBlockState(), hidden.getBlockState(6, 8, 4));
+        assertEquals(Blocks.CAVE_AIR.defaultBlockState(), this.sections[0].getBlockState(4, 8, 4));

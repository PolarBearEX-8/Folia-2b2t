@@ -0,0 +1,713 @@
+package io.papermc.paper.antixray;
+
+import com.google.common.cache.Cache;
+import com.google.common.cache.CacheBuilder;
+import it.unimi.dsi.fastutil.shorts.Short2ObjectLinkedOpenHashMap;
+import io.papermc.paper.configuration.WorldConfiguration;
+import java.time.Duration;
+import java.util.BitSet;
+import java.util.HashMap;
+import java.util.Map;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.Direction;
+import net.minecraft.core.SectionPos;
+import net.minecraft.core.registries.Registries;
+import net.minecraft.network.protocol.Packet;
+import net.minecraft.network.protocol.game.ClientGamePacketListener;
+import net.minecraft.network.protocol.game.ClientboundBlockDestructionPacket;
+import net.minecraft.network.protocol.game.ClientboundBlockEntityDataPacket;
+import net.minecraft.network.protocol.game.ClientboundBlockEventPacket;
+import net.minecraft.network.protocol.game.ClientboundBlockUpdatePacket;
+import net.minecraft.network.protocol.game.ClientboundBundlePacket;
+import net.minecraft.network.protocol.game.ClientboundForgetLevelChunkPacket;
+import net.minecraft.network.protocol.game.ClientboundLevelChunkPacketData;
+import net.minecraft.network.protocol.game.ClientboundLevelChunkWithLightPacket;
+import net.minecraft.network.protocol.game.ClientboundLevelEventPacket;
+import net.minecraft.network.protocol.game.ClientboundLightUpdatePacket;
+import net.minecraft.network.protocol.game.ClientboundLightUpdatePacketData;
+import net.minecraft.network.protocol.game.ClientboundLoginPacket;
+import net.minecraft.network.protocol.game.ClientboundRespawnPacket;
+import net.minecraft.network.protocol.game.ClientboundSectionBlocksUpdatePacket;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.network.protocol.game.ServerboundPlayerActionPacket;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.tags.BlockTags;
+import net.minecraft.world.level.ChunkPos;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.level.biome.Biomes;
+import net.minecraft.world.level.block.Block;
+import net.minecraft.world.level.block.Blocks;
+import net.minecraft.world.level.block.state.BlockState;
+import net.minecraft.world.level.chunk.EmptyLevelChunk;
+import net.minecraft.world.level.chunk.GlobalPalette;
+import net.minecraft.world.level.chunk.LevelChunk;
+import net.minecraft.world.level.chunk.LevelChunkSection;
+import net.minecraft.world.level.chunk.MissingPaletteEntryException;
+import net.minecraft.world.level.chunk.Palette;
+import net.minecraft.world.level.chunk.PaletteResize;
+
+/** Mode 4: conceal undiscovered underground cells with client-only solid terrain. */
+public final class ChunkPacketBlockControllerCave extends ChunkPacketBlockController {
+    private static final Palette<BlockState> GLOBAL_BLOCKSTATE_PALETTE = new GlobalPalette<>(Block.BLOCK_STATE_REGISTRY);
+    private static final int REVEAL_RADIUS = 24;
+    private static final int REVEAL_BUDGET = 32768;
+    private static final int ENTRANCE_DEPTH = 12;
+    private static final int REFRESHES_PER_TICK = 2;
+    private final Level level;
+    private final int minY;
+    private final int maxY;
+    private final boolean usePermission;
+    private final boolean lavaObscures;
+    private final int updateRadius;
+    private final boolean[] legacySolidGlobal = new boolean[Block.BLOCK_STATE_REGISTRY.size()];
+    private final boolean[] legacyCandidateGlobal = new boolean[Block.BLOCK_STATE_REGISTRY.size()];
+    private final Cache<Long, Snapshot> snapshots = CacheBuilder.newBuilder().maximumSize(256)
+        .expireAfterAccess(Duration.ofSeconds(30)).build();
+    private final Cache<Long, LevelChunk> sources = CacheBuilder.newBuilder().maximumSize(256)
+        .expireAfterAccess(Duration.ofSeconds(60)).build();
+    private final Cache<Long, BitSet> exterior = CacheBuilder.newBuilder().maximumSize(256)
+        .expireAfterAccess(Duration.ofSeconds(30)).build();
+    private final Cache<Long, Long> revisions = CacheBuilder.newBuilder().maximumSize(4096).build();
+    private final Cache<Long, Long> geometryRevisions = CacheBuilder.newBuilder().maximumSize(4096).build();
+    private final java.util.concurrent.atomic.AtomicLong revisionSequence = new java.util.concurrent.atomic.AtomicLong();
+
+    public ChunkPacketBlockControllerCave(Level level) {
+        this(level, level.paperConfig().anticheat.antiXray.maxBlockHeight, level.paperConfig().anticheat.antiXray.usePermission);
+    }
+
+    ChunkPacketBlockControllerCave(Level level, int maxHeight, boolean usePermission) {
+        this.level = level;
+        this.minY = level.getMinY();
+        this.maxY = Math.min(level.getMaxY() + 1, maxHeight >> 4 << 4);
+        this.usePermission = usePermission;
+        WorldConfiguration.Anticheat.AntiXray config = level.paperConfig().anticheat.antiXray;
+        this.lavaObscures = config.lavaObscures;
+        this.updateRadius = config.updateRadius;
+
+        EmptyLevelChunk emptyChunk = new EmptyLevelChunk(level, new ChunkPos(0, 0),
+            MinecraftServer.getServer().registryAccess().lookupOrThrow(Registries.BIOME).getOrThrow(Biomes.PLAINS));
+        BlockPos zeroPos = BlockPos.ZERO;
+        for (int id = 0; id < this.legacySolidGlobal.length; id++) {
+            BlockState block = GLOBAL_BLOCKSTATE_PALETTE.valueFor(id);
+            if (block == null) continue;
+            boolean solid = block.isRedstoneConductor(emptyChunk, zeroPos)
+                && !block.is(Blocks.SPAWNER) && !block.is(Blocks.BARRIER) && !block.is(Blocks.SHULKER_BOX)
+                && !block.is(Blocks.SLIME_BLOCK) && !block.is(Blocks.MANGROVE_ROOTS)
+                || this.lavaObscures && block == Blocks.LAVA.defaultBlockState();
+            this.legacySolidGlobal[id] = solid;
+            this.legacyCandidateGlobal[id] = solid && !block.is(BlockTags.LOGS) && !block.is(BlockTags.LEAVES);
+        }
+    }
+
+    @Override
+    public boolean shouldModify(ServerPlayer player, LevelChunk chunk) {
+        return !bypass(player);
+    }
+
+    private boolean bypass(ServerPlayer player) {
+        return this.usePermission && player.getBukkitEntity().hasPermission("paper.antixray.bypass");
+    }
+
+    @Override
+    public boolean shouldTrackEntity(ServerPlayer player, net.minecraft.world.entity.Entity entity) {
+        return shouldTrackEntity(player, entity, player.connection.caveVisibility);
+    }
+
+    boolean shouldTrackEntity(ServerPlayer player, net.minecraft.world.entity.Entity entity, CavePlayerState state) {
+        synchronized (state) {
+            state.reset(this);
+            return bypass(player) || CaveEffectFilter.protectedEntity(player, entity.getId()) || visible(state, entity.blockPosition());
+        }
+    }
+
+    private Snapshot snapshot(LevelChunk chunk) {
+        long key = chunk.getPos().pack();
+        Snapshot result = this.snapshots.getIfPresent(key);
+        if (result != null && result.source == chunk && result.revision == geometryRevision(key)) return result;
+        if (this.sources.getIfPresent(key) != chunk) {
+            this.sources.put(key, chunk);
+            invalidateExterior(chunk.getPos().x(), chunk.getPos().z(), false);
+        }
+        long revision = geometryRevision(key);
+        // PalettedContainer writes synchronize on the container. Never read mutable neighbor palettes in a flood fill.
+        LevelChunkSection[] sections = copySections(chunk);
+        int height = this.level.getHeight();
+        BitSet open = new BitSet(height * 256);
+        BitSet sky = new BitSet(height * 256);
+        BitSet legacySolid = new BitSet(height * 256);
+        BitSet legacyCandidate = new BitSet(height * 256);
+        boolean endVoid = this.level.getWorld().getEnvironment() == org.bukkit.World.Environment.THE_END;
+        for (int z = 0; z < 16; z++) {
+            for (int x = 0; x < 16; x++) {
+                // Open space above the Nether roof is exterior too, despite having no skylight.
+                boolean covered = false;
+                for (int relativeY = height - 1; relativeY >= 0; relativeY--) {
+                    BlockState block = sections[relativeY >> 4].getBlockState(x, relativeY & 15, z);
+                    int blockIndex = relativeY * 256 + z * 16 + x;
+                    if (legacySolid(block)) legacySolid.set(blockIndex);
+                    if (legacyCandidate(block)) legacyCandidate.set(blockIndex);
+                    if (block.isSolidRender()) covered = true;
+                    else {
+                        int index = relativeY * 256 + z * 16 + x;
+                        open.set(index);
+                        if (!covered) sky.set(index);
+                    }
+                }
+                if (endVoid) {
+                    // Preserve the void beneath End islands instead of inventing solid columns under them.
+                    for (int relativeY = 0; relativeY < height; relativeY++) {
+                        if (sections[relativeY >> 4].getBlockState(x, relativeY & 15, z).isSolidRender()) break;
+                        sky.set(relativeY * 256 + z * 16 + x);
+                    }
+                }
+            }
+        }
+        result = new Snapshot(chunk, open, sky, legacySolid, legacyCandidate, revision);
+        this.snapshots.put(key, result);
+        if (revision != geometryRevision(key)) this.snapshots.invalidate(key);
+        return result;
+    }
+
+    private static LevelChunkSection[] copySections(LevelChunk chunk) {
+        LevelChunkSection[] sections = chunk.getSections().clone();
+        for (int i = 0; i < sections.length; i++) {
+            LevelChunkSection section = sections[i];
+            synchronized (section.getStates()) {
+                sections[i] = section.copy();
+            }
+            sections[i].recalcBlockCounts();
+        }
+        return sections;
+    }
+
+    /** Applies the old mode-4 occlusion test to the cave packet view, keeping concealed blocks solid. */
+    private BitSet applyLegacyOcclusion(CavePlayerState state, LevelChunk chunk,
+                                        LevelChunkSection[] sections, BitSet visibleCells) {
+        BitSet replace = new BitSet(this.level.getHeight() * 256);
+        int chunkX = chunk.getPos().getMinBlockX();
+        int chunkZ = chunk.getPos().getMinBlockZ();
+        for (int y = this.minY; y < this.maxY; y++) {
+            int sectionIndex = (y - this.minY) >> 4;
+            int localY = y & 15;
+            LevelChunkSection section = sections[sectionIndex];
+            for (int z = 0; z < 16; z++) {
+                for (int x = 0; x < 16; x++) {
+                    int worldX = chunkX + x;
+                    int worldZ = chunkZ + z;
+                    if (!visible(visibleCells, worldX, y, worldZ)) continue;
+                    BlockState block = section.getBlockState(x, localY, z);
+                    if (!legacyCandidate(block)) continue;
+                    BlockPos pos = new BlockPos(worldX, y, worldZ);
+                    if (packetSolid(state, chunk.getPos().pack(), visibleCells, sections, pos.relative(Direction.WEST))
+                        && packetSolid(state, chunk.getPos().pack(), visibleCells, sections, pos.relative(Direction.EAST))
+                        && packetSolid(state, chunk.getPos().pack(), visibleCells, sections, pos.below())
+                        && packetSolid(state, chunk.getPos().pack(), visibleCells, sections, pos.above())
+                        && packetSolid(state, chunk.getPos().pack(), visibleCells, sections, pos.relative(Direction.NORTH))
+                        && packetSolid(state, chunk.getPos().pack(), visibleCells, sections, pos.relative(Direction.SOUTH))) {
+                        replace.set((y - this.minY) * 256 + z * 16 + x);
+                    }
+                }
+            }
+        }
+        for (int index = replace.nextSetBit(0); index >= 0; index = replace.nextSetBit(index + 1)) {
+            int y = this.minY + (index >> 8);
+            int z = (index >> 4) & 15;
+            int x = index & 15;
+            sections[(y - this.minY) >> 4].setBlockState(x, y & 15, z, replacement(y), false);
+        }
+        for (LevelChunkSection section : sections) section.recalcBlockCounts();
+        return replace;
+    }
+
+    private boolean packetSolid(CavePlayerState state, long activeChunk,
+                                BitSet activeCells, LevelChunkSection[] activeSections, BlockPos pos) {
+        if (pos.getY() < this.minY || pos.getY() >= this.maxY) return false;
+        long key = ChunkPos.pack(pos.getX() >> 4, pos.getZ() >> 4);
+        if (key == activeChunk) {
+            if (!visible(activeCells, pos.getX(), pos.getY(), pos.getZ())) return legacySolid(replacement(pos.getY()));
+            return legacySolid(activeSections[(pos.getY() - this.minY) >> 4]
+                .getBlockState(pos.getX() & 15, pos.getY() & 15, pos.getZ() & 15));
+        }
+        CavePlayerState.View view = state.sent.get(key);
+        if (view == null || !view.bypass() && !visible(view.cells(), pos.getX(), pos.getY(), pos.getZ())) {
+            return legacySolid(replacement(pos.getY()));
+        }
+        LevelChunk chunk = this.level.getChunkIfLoaded(pos.getX() >> 4, pos.getZ() >> 4);
+        if (chunk == null) return legacySolid(replacement(pos.getY()));
+        return snapshot(chunk).legacySolid.get((pos.getY() - this.minY) * 256 + (pos.getZ() & 15) * 16 + (pos.getX() & 15));
+    }
+
+    private boolean packetSolid(CavePlayerState state, BlockPos pos) {
+        return packetSolid(state, Long.MIN_VALUE, null, null, pos);
+    }
+
+    private boolean legacySolid(BlockState state) {
+        try {
+            return this.legacySolidGlobal[GLOBAL_BLOCKSTATE_PALETTE.idFor(state, PaletteResize.noResizeExpected())];
+        } catch (MissingPaletteEntryException exception) {
+            return false;
+        }
+    }
+
+    private boolean legacyCandidate(BlockState state) {
+        try {
+            return this.legacyCandidateGlobal[GLOBAL_BLOCKSTATE_PALETTE.idFor(state, PaletteResize.noResizeExpected())];
+        } catch (MissingPaletteEntryException exception) {
+            return false;
+        }
+    }
+
+    private BlockState filterVisibleState(CavePlayerState state, BlockPos pos, BlockState block) {
+        return legacyOccluded(state, pos, block) ? replacement(pos.getY()) : block;
+    }
+
+    private boolean legacyOccluded(CavePlayerState state, BlockPos pos, BlockState block) {
+        if (pos.getY() < this.minY || pos.getY() >= this.maxY || !legacyCandidate(block)) return false;
+        return packetSolid(state, pos.relative(Direction.WEST))
+            && packetSolid(state, pos.relative(Direction.EAST))
+            && packetSolid(state, pos.below())
+            && packetSolid(state, pos.above())
+            && packetSolid(state, pos.relative(Direction.NORTH))
+            && packetSolid(state, pos.relative(Direction.SOUTH));
+    }
+
+    private boolean legacyOccludedAt(CavePlayerState state, BlockPos pos) {
+        return packetCandidate(state, pos) && packetSolid(state, pos.relative(Direction.WEST))
+            && packetSolid(state, pos.relative(Direction.EAST))
+            && packetSolid(state, pos.below())
+            && packetSolid(state, pos.above())
+            && packetSolid(state, pos.relative(Direction.NORTH))
+            && packetSolid(state, pos.relative(Direction.SOUTH));
+    }
+
+    private boolean packetCandidate(CavePlayerState state, BlockPos pos) {
+        if (pos.getY() < this.minY || pos.getY() >= this.maxY || !visible(state, pos)) return false;
+        LevelChunk chunk = this.level.getChunkIfLoaded(pos.getX() >> 4, pos.getZ() >> 4);
+        return chunk != null && snapshot(chunk).legacyCandidate.get(
+            (pos.getY() - this.minY) * 256 + (pos.getZ() & 15) * 16 + (pos.getX() & 15));
+    }
+
+    private void invalidateExterior(int chunkX, int chunkZ, boolean terrainChanged) {
+        for (int dz = -1; dz <= 1; dz++) {
+            for (int dx = -1; dx <= 1; dx++) {
+                this.exterior.invalidate(ChunkPos.pack(chunkX + dx, chunkZ + dz));
+                if (terrainChanged) this.revisions.put(ChunkPos.pack(chunkX + dx, chunkZ + dz), this.revisionSequence.incrementAndGet());
+            }
+        }
+    }
+
+    private Grid grid(int baseX, int baseY, int baseZ, int width, int height, int depth, boolean includeSky) {
+        BitSet open = new BitSet(width * height * depth);
+        BitSet sky = new BitSet(width * height * depth);
+        for (int cz = baseZ >> 4; cz <= (baseZ + depth - 1) >> 4; cz++) {
+            for (int cx = baseX >> 4; cx <= (baseX + width - 1) >> 4; cx++) {
+                LevelChunk chunk = this.level.getChunkIfLoaded(cx, cz);
+                if (chunk == null) continue; // Unknown chunks stay closed; never cause loads or generation.
+                Snapshot snapshot = snapshot(chunk);
+                for (int y = Math.max(baseY, this.minY); y < Math.min(baseY + height, this.minY + this.level.getHeight()); y++) {
+                    for (int z = Math.max(baseZ, cz << 4); z < Math.min(baseZ + depth, (cz + 1) << 4); z++) {
+                        for (int x = Math.max(baseX, cx << 4); x < Math.min(baseX + width, (cx + 1) << 4); x++) {
+                            int local = (y - this.minY) * 256 + (z & 15) * 16 + (x & 15);
+                            int index = ((y - baseY) * depth + z - baseZ) * width + x - baseX;
+                            if (snapshot.open.get(local)) open.set(index);
+                            if (includeSky && snapshot.sky.get(local)) sky.set(index);
+                        }
+                    }
+                }
+            }
+        }
+        return new Grid(baseX, baseY, baseZ, width, height, depth, open, sky);
+    }
+
+    private BitSet exterior(LevelChunk chunk) {
+        long key = chunk.getPos().pack();
+        // Ensure a reloaded chunk cannot inherit an old topology at the same coordinates.
+        snapshot(chunk);
+        BitSet result = this.exterior.getIfPresent(key);
+        if (result != null) return result;
+        long revision = revision(key);
+        Grid grid = grid(chunk.getPos().getMinBlockX() - 16, this.minY, chunk.getPos().getMinBlockZ() - 16,
+            48, this.level.getHeight(), 48, true);
+        BitSet visible = CaveVisibility.exterior(grid.open, grid.sky, grid.width, grid.height, grid.depth, ENTRANCE_DEPTH);
+        result = CaveVisibility.projectToChunk(visible, grid.x, grid.y, grid.z, grid.width, grid.height, grid.depth,
+            this.minY, this.maxY, chunk.getPos().getMinBlockX(), chunk.getPos().getMinBlockZ());
+        this.exterior.put(key, result);
+        if (revision != revision(key)) this.exterior.invalidate(key);
+        return result;
+    }
+
+    private Map<Long, BitSet> nearby(ServerPlayer player) {
+        BlockPos pos = player.blockPosition();
+        int width = REVEAL_RADIUS * 2 + 1;
+        Grid grid = grid(pos.getX() - REVEAL_RADIUS, pos.getY() - REVEAL_RADIUS, pos.getZ() - REVEAL_RADIUS,
+            width, width, width, false);
+        BitSet seeds = new BitSet();
+        // Multiple seeds handle swimming, crawling and a player whose feet are inside a non-full block.
+        for (int y = REVEAL_RADIUS - 1; y <= REVEAL_RADIUS + 2; y++) {
+            for (int z = REVEAL_RADIUS - 1; z <= REVEAL_RADIUS + 1; z++) {
+                for (int x = REVEAL_RADIUS - 1; x <= REVEAL_RADIUS + 1; x++) {
+                    seeds.set((y * width + z) * width + x);
+                }
+            }
+        }
+        BitSet visited = CaveVisibility.flood(grid.open, seeds, width, width, width, REVEAL_RADIUS, REVEAL_BUDGET);
+        Map<Long, BitSet> cells = toCells(grid, visited);
+        // Safety shell prevents fake client collision when digging, falling or arriving by teleport.
+        addSafety(cells, pos);
+        return cells;
+    }
+
+    private void addSafety(Map<Long, BitSet> cells, BlockPos pos) {
+        for (int y = pos.getY() - 8; y <= pos.getY() + 8; y += 4) {
+            for (int z = pos.getZ() - 8; z <= pos.getZ() + 8; z += 4) {
+                for (int x = pos.getX() - 8; x <= pos.getX() + 8; x += 4) addCell(cells, x, y, z);
+            }
+        }
+    }
+
+    private Map<Long, BitSet> toCells(Grid grid, BitSet visited) {
+        Map<Long, BitSet> result = new HashMap<>();
+        long[] words = visited.toLongArray();
+        for (int y = Math.max(Math.floorDiv(grid.y, 4) * 4, this.minY - 4); y < Math.min(grid.y + grid.height, this.maxY + 4); y += 4) {
+            for (int z = Math.floorDiv(grid.z, 4) * 4; z < grid.z + grid.depth; z += 4) {
+                for (int x = Math.floorDiv(grid.x, 4) * 4; x < grid.x + grid.width; x += 4) {
+                    boolean found = false;
+                    for (int by = Math.max(y, grid.y); by < Math.min(y + 4, grid.y + grid.height) && !found; by++) {
+                        for (int bz = Math.max(z, grid.z); bz < Math.min(z + 4, grid.z + grid.depth); bz++) {
+                            int start = ((by - grid.y) * grid.depth + bz - grid.z) * grid.width + Math.max(x, grid.x) - grid.x;
+                            int end = start + Math.min(x + 4, grid.x + grid.width) - Math.max(x, grid.x);
+                            if (CaveVisibility.anySet(words, start, end)) { found = true; break; }
+                        }
+                    }
+                    if (!found) continue;
+                    addCell(result, x, y, z);
+                    // Preserve walls around revealed air cells across section and chunk boundaries.
+                    addCell(result, x - 4, y, z); addCell(result, x + 4, y, z);
+                    addCell(result, x, y - 4, z); addCell(result, x, y + 4, z);
+                    addCell(result, x, y, z - 4); addCell(result, x, y, z + 4);
+                }
+            }
+        }
+        return result;
+    }
+
+    private void addCell(Map<Long, BitSet> result, int x, int y, int z) {
+        if (y < this.minY || y >= this.maxY) return;
+        result.computeIfAbsent(ChunkPos.pack(x >> 4, z >> 4), ignored -> new BitSet())
+            .set(CaveVisibility.cellIndex(x, y, z, this.minY));
+    }
+
+    @Override
+    public void tickPlayer(ServerPlayer player) {
+        CavePlayerState state = player.connection.caveVisibility;
+        synchronized (state) {
+            state.reset(this);
+            if (state.ticks++ % 5 == 0) {
+                BlockPos position = player.blockPosition();
+                boolean moved = state.lastX == Integer.MIN_VALUE || Math.abs((long)position.getX() - state.lastX)
+                    + Math.abs((long)position.getY() - state.lastY) + Math.abs((long)position.getZ() - state.lastZ) >= 2;
+                boolean dirty = state.sent.entrySet().stream().anyMatch(entry -> state.nearby.containsKey(entry.getKey())
+                    && entry.getValue().revision() != revision(entry.getKey()));
+                if (moved || dirty || state.ticks % 40 == 1) {
+                    state.nearby = nearby(player);
+                    state.lastX = position.getX();
+                    state.lastY = position.getY();
+                    state.lastZ = position.getZ();
+                }
+                boolean bypass = bypass(player);
+                for (Map.Entry<Long, CavePlayerState.View> entry : state.sent.entrySet()) {
+                    BitSet requested = state.nearby.get(entry.getKey());
+                    if (entry.getValue().bypass() != bypass || entry.getValue().revision() != revision(entry.getKey())
+                        || (requested != null && !contains(entry.getValue().cells(), requested))) {
+                        state.queue(entry.getKey());
+                    }
+                }
+            }
+            // Update the collision safety shell every tick, including while falling or riding.
+            Map<Long, BitSet> safety = new HashMap<>();
+            addSafety(safety, player.blockPosition());
+            net.minecraft.world.phys.Vec3 motion = player.getDeltaMovement();
+            addSafety(safety, player.blockPosition().offset(
+                (int)Math.clamp(motion.x * 3, -12, 12), (int)Math.clamp(motion.y * 3, -12, 12),
+                (int)Math.clamp(motion.z * 3, -12, 12)));
+            Map<Long, BitSet> nearby = new HashMap<>(state.nearby);
+            for (Map.Entry<Long, BitSet> entry : safety.entrySet()) {
+                BitSet cells = (BitSet)entry.getValue().clone();
+                if (nearby.containsKey(entry.getKey())) cells.or(nearby.get(entry.getKey()));
+                nearby.put(entry.getKey(), cells);
+                CavePlayerState.View sent = state.sent.get(entry.getKey());
+                if (sent != null && !sent.bypass() && !contains(sent.cells(), cells) && state.queued.add(entry.getKey())) {
+                    state.pending.addFirst(entry.getKey());
+                }
+            }
+            state.nearby = nearby;
+            for (int i = 0; i < REFRESHES_PER_TICK && !state.pending.isEmpty(); i++) {
+                long key = state.pending.removeFirst();
+                state.queued.remove(key);
+                if (!io.papermc.paper.FeatureHooks.isChunkSent(player, key)) continue;
+                LevelChunk chunk = this.level.getChunkIfLoaded(ChunkPos.getX(key), ChunkPos.getZ(key));
+                if (chunk == null) continue;
+                refresh(player, state, chunk);
+            }
+        }
+    }
+
+    private void refresh(ServerPlayer player, CavePlayerState state, LevelChunk chunk) {
+        long key = chunk.getPos().pack();
+        CavePlayerState.View previous = state.sent.get(key);
+        if (previous == null || previous.bypass() != bypass(player)) {
+            player.connection.send(new ClientboundLevelChunkWithLightPacket(chunk, this.level.getLightEngine(), null, null, false));
+            return;
+        }
+        if (previous.bypass()) return;
+        long revision = revision(key);
+        BitSet cells = (BitSet)previous.cells().clone();
+        if (previous.revision() != revision) cells.or(exterior(chunk));
+        BitSet nearby = state.nearby.get(key);
+        if (nearby != null) cells.or(nearby);
+        BitSet added = (BitSet)cells.clone();
+        added.andNot(previous.cells());
+        state.sent.put(key, new CavePlayerState.View(cells, false, revision));
+        if (added.isEmpty()) return;
+
+        BitSet lightSections = new BitSet();
+        int minLightSection = this.level.getLightEngine().getMinLightSection();
+        for (int index = 0; index < chunk.getSections().length; index++) {
+            int firstCell = index * 64;
+            int nextCell = added.nextSetBit(firstCell);
+            if (nextCell < 0 || nextCell >= firstCell + 64) continue;
+            LevelChunkSection source = chunk.getSections()[index];
+            LevelChunkSection copy;
+            synchronized (source.getStates()) { copy = source.copy(); }
+            Short2ObjectLinkedOpenHashMap<BlockState> updates = new Short2ObjectLinkedOpenHashMap<>();
+            for (int cell = nextCell; cell >= 0 && cell < firstCell + 64; cell = added.nextSetBit(cell + 1)) {
+                int local = cell - firstCell;
+                int x0 = (local & 3) * 4;
+                int z0 = ((local >> 2) & 3) * 4;
+                int y0 = (local >> 4) * 4;
+                for (int y = y0; y < y0 + 4; y++) {
+                    for (int z = z0; z < z0 + 4; z++) {
+                        for (int x = x0; x < x0 + 4; x++) {
+                            BlockPos pos = new BlockPos(chunk.getPos().getMinBlockX() + x, this.minY + index * 16 + y,
+                                chunk.getPos().getMinBlockZ() + z);
+                            updates.put((short)((x << 8) | (z << 4) | y), filterVisibleState(state, pos, copy.getBlockState(x, y, z)));
+                        }
+                    }
+                }
+            }
+            int sectionY = (this.minY >> 4) + index;
+            player.connection.send(new ClientboundSectionBlocksUpdatePacket(SectionPos.of(chunk.getPos(), sectionY), updates));
+            lightSections.set(sectionY - minLightSection);
+        }
+        player.connection.send(new ClientboundLightUpdatePacket(chunk.getPos(), this.level.getLightEngine(), lightSections, lightSections));
+        for (Map.Entry<BlockPos, net.minecraft.world.level.block.entity.BlockEntity> entry : chunk.getBlockEntities().entrySet()) {
+            BlockPos pos = entry.getKey();
+            if (pos.getY() < this.minY || pos.getY() >= this.maxY
+                || !added.get(CaveVisibility.cellIndex(pos.getX(), pos.getY(), pos.getZ(), this.minY))
+                || legacyOccludedAt(state, pos)) continue;
+            Packet<?> update = entry.getValue().getUpdatePacket();
+            if (update != null) player.connection.send(update);
+        }
+    }
+
+    private static boolean contains(BitSet existing, BitSet requested) {
+        BitSet difference = (BitSet)requested.clone();
+        difference.andNot(existing);
+        return difference.isEmpty();
+    }
+
+    private long revision(long key) {
+        Long value = this.revisions.getIfPresent(key);
+        return value == null ? 0L : value;
+    }
+
+    private long geometryRevision(long key) {
+        Long value = this.geometryRevisions.getIfPresent(key);
+        return value == null ? 0L : value;
+    }
+
+    @Override
+    public Packet<?> filterPacket(ServerPlayer player, Packet<?> packet) {
+        return filterPacket(player, packet, player.connection.caveVisibility);
+    }
+
+    Packet<?> filterPacket(ServerPlayer player, Packet<?> packet, CavePlayerState state) {
+        synchronized (state) {
+            state.reset(this);
+            if (packet instanceof ClientboundRespawnPacket || packet instanceof ClientboundLoginPacket) {
+                state.clear();
+                return packet;
+            }
+            if (packet instanceof ClientboundForgetLevelChunkPacket forget) {
+                long key = forget.pos().pack();
+                state.sent.remove(key);
+                state.queued.remove(key);
+                state.pending.remove(key);
+                Map<Long, BitSet> next = new HashMap<>(state.nearby);
+                next.remove(key);
+                state.nearby = next;
+                return packet;
+            }
+            if (packet instanceof ClientboundBundlePacket bundle) {
+                java.util.List<Packet<? super ClientGamePacketListener>> children = new java.util.ArrayList<>();
+                for (Packet<? super ClientGamePacketListener> child : bundle.subPackets()) {
+                    Packet<?> filtered = filterPacket(player, child, state);
+                    if (filtered != null) children.add(gamePacket(filtered));
+                }
+                return children.isEmpty() ? null : new ClientboundBundlePacket(children);
+            }
+            boolean bypass = bypass(player);
+            if (packet instanceof ClientboundLevelChunkWithLightPacket chunkPacket) {
+                LevelChunk chunk = this.level.getChunkIfLoaded(chunkPacket.getX(), chunkPacket.getZ());
+                if (chunk == null) return null;
+                long key = chunk.getPos().pack();
+                if (bypass) {
+                    state.sent.put(key, new CavePlayerState.View(new BitSet(), true, revision(key)));
+                    return chunkPacket;
+                }
+                long revision = revision(key);
+                BitSet cells = (BitSet)exterior(chunk).clone();
+                CavePlayerState.View previous = state.sent.get(key);
+                if (previous != null && !previous.bypass()) cells.or(previous.cells());
+                BitSet nearby = state.nearby.get(key);
+                if (nearby != null) cells.or(nearby);
+                // Include the current safety shell even before the first player tick or after a teleport.
+                Map<Long, BitSet> safety = new HashMap<>();
+                addSafety(safety, player.blockPosition());
+                if (safety.containsKey(key)) cells.or(safety.get(key));
+                // Always serialize current block states, even if the topology cache is still valid.
+                LevelChunkSection[] sections = copySections(chunk);
+                for (int section = 0; section < sections.length; section++) {
+                    int bottom = this.minY + section * 16;
+                    if (bottom >= this.maxY) continue;
+                    LevelChunkSection copy = sections[section];
+                    for (int y = 0; y < 16; y++) {
+                        BlockState replacement = replacement(bottom + y);
+                        for (int z = 0; z < 16; z++) {
+                            for (int x = 0; x < 16; x++) {
+                                if (!visible(cells, x, bottom + y, z)) copy.setBlockState(x, y, z, replacement, false);
+                            }
+                        }
+                    }
+                    sections[section] = copy;
+                }
+                BitSet legacyReplaced = applyLegacyOcclusion(state, chunk, sections, cells);
+                ClientboundLevelChunkPacketData data = new ClientboundLevelChunkPacketData(chunk, sections,
+                    pos -> visible(cells, pos.getX(), pos.getY(), pos.getZ())
+                        && (pos.getY() < this.minY || pos.getY() >= this.maxY
+                            || !legacyReplaced.get((pos.getY() - this.minY) * 256 + (pos.getZ() & 15) * 16 + (pos.getX() & 15))));
+                ClientboundLightUpdatePacketData light = maskLight(chunkPacket.getLightData(), cells);
+                state.sent.put(key, new CavePlayerState.View(cells, false, revision));
+                return new ClientboundLevelChunkWithLightPacket(chunkPacket, data, light);
+            }
+            packet = CaveEffectFilter.filter(this, player, packet, state, bypass);
+            if (packet == null || bypass) return packet;
+            if (packet instanceof ClientboundBlockUpdatePacket update) {
+                BlockPos pos = update.getPos();
+                return new ClientboundBlockUpdatePacket(pos, visible(state, pos)
+                    ? filterVisibleState(state, pos, update.getBlockState()) : replacement(pos.getY()));
+            }
+            if (packet instanceof ClientboundSectionBlocksUpdatePacket updates) {
+                Short2ObjectLinkedOpenHashMap<BlockState> changes = new Short2ObjectLinkedOpenHashMap<>();
+                SectionPos[] section = new SectionPos[1];
+                updates.runUpdates((pos, block) -> {
+                    section[0] = SectionPos.of(pos);
+                    changes.put(SectionPos.sectionRelativePos(pos), visible(state, pos)
+                        ? filterVisibleState(state, pos, block) : replacement(pos.getY()));
+                });
+                return section[0] == null ? packet : new ClientboundSectionBlocksUpdatePacket(section[0], changes);
+            }
+            if (packet instanceof ClientboundBlockEntityDataPacket entity
+                && (!visible(state, entity.getPos()) || legacyOccludedAt(state, entity.getPos()))) return null;
+            if (packet instanceof ClientboundBlockEventPacket event
+                && (!visible(state, event.getPos()) || legacyOccludedAt(state, event.getPos()))) return null;
+            if (packet instanceof ClientboundBlockDestructionPacket destruction
+                && (!visible(state, destruction.getPos()) || legacyOccludedAt(state, destruction.getPos()))) return null;
+            if (packet instanceof ClientboundLevelEventPacket event
+                && (!visible(state, event.getPos()) || legacyOccludedAt(state, event.getPos()))) return null;
+            if (packet instanceof ClientboundLightUpdatePacket light) {
+                CavePlayerState.View view = state.sent.get(ChunkPos.pack(light.getX(), light.getZ()));
+                BitSet cells = view == null ? new BitSet() : view.cells();
+                return new ClientboundLightUpdatePacket(light, maskLight(light.getLightData(), cells));
+            }
+            return packet;
+        }
+    }
+
+    @SuppressWarnings("unchecked")
+    private static Packet<? super ClientGamePacketListener> gamePacket(Packet<?> packet) {
+        return (Packet<? super ClientGamePacketListener>)packet;
+    }
+
+    private ClientboundLightUpdatePacketData maskLight(ClientboundLightUpdatePacketData light, BitSet cells) {
+        return light.copyWithMask(index -> visible(cells, index & 15, index >> 8, (index >> 4) & 15),
+            this.level.getLightEngine().getMinLightSection());
+    }
+
+    private boolean visible(BitSet cells, int x, int y, int z) {
+        return CaveVisibility.visible(cells, x, y, z, this.minY, this.maxY);
+    }
+
+    boolean visible(CavePlayerState state, BlockPos pos) {
+        if (pos.getY() < this.minY || pos.getY() >= this.maxY) return true;
+        CavePlayerState.View view = state.sent.get(ChunkPos.pack(pos.getX() >> 4, pos.getZ() >> 4));
+        return view != null && (view.bypass() || visible(view.cells(), pos.getX(), pos.getY(), pos.getZ()));
+    }
+
+    private BlockState replacement(int y) {
+        return switch (this.level.getWorld().getEnvironment()) {
+            case NETHER -> Blocks.NETHERRACK.defaultBlockState();
+            case THE_END -> Blocks.END_STONE.defaultBlockState();
+            default -> (y < 0 ? Blocks.DEEPSLATE : Blocks.STONE).defaultBlockState();
+        };
+    }
+
+    @Override
+    public void onBlockChange(Level level, BlockPos pos, BlockState newState, BlockState oldState, @Block.UpdateFlags int flags, int depth) {
+        if (oldState == null || oldState == newState) return;
+        long key = ChunkPos.pack(pos.getX() >> 4, pos.getZ() >> 4);
+        // The cached topology is still valid for same-opacity edits, but legacy solid masks are not.
+        this.snapshots.invalidate(key);
+        if (oldState.isSolidRender() != newState.isSolidRender()) {
+            this.geometryRevisions.put(key, this.revisionSequence.incrementAndGet());
+            invalidateExterior(pos.getX() >> 4, pos.getZ() >> 4, true);
+        }
+        if (legacySolid(oldState) && !legacySolid(newState) && pos.getY() <= this.maxY + this.updateRadius - 1) {
+            updateNearbyBlocks(level, pos);
+        }
+    }
+
+    @Override
+    public void onPlayerLeftClickBlock(Level level, BlockPos pos, ServerboundPlayerActionPacket.Action action,
+                                      Direction direction, int worldHeight, int sequence) {
+        if (pos.getY() <= this.maxY + this.updateRadius - 1) updateNearbyBlocks(level, pos);
+    }
+
+    private void updateNearbyBlocks(Level level, BlockPos origin) {
+        if (this.updateRadius <= 0) return;
+        int radius = this.updateRadius == 1 ? 1 : 2;
+        for (int dy = -radius; dy <= radius; dy++) {
+            for (int dz = -radius; dz <= radius; dz++) {
+                for (int dx = -radius; dx <= radius; dx++) {
+                    int distance = Math.abs(dx) + Math.abs(dy) + Math.abs(dz);
+                    if (distance == 0 || distance > radius) continue;
+                    BlockPos pos = origin.offset(dx, dy, dz);
+                    if (pos.getY() < this.minY || pos.getY() >= this.maxY) continue;
+                    LevelChunk chunk = level.getChunkIfLoaded(pos.getX() >> 4, pos.getZ() >> 4);
+                    if (chunk != null && snapshot(chunk).legacyCandidate.get(
+                        (pos.getY() - this.minY) * 256 + (pos.getZ() & 15) * 16 + (pos.getX() & 15))) {
+                        ((ServerLevel)level).getChunkSource().blockChanged(pos);
+                    }
+                }
+            }
+        }
+    }
+
+    private record Snapshot(LevelChunk source, BitSet open, BitSet sky, BitSet legacySolid,
+                            BitSet legacyCandidate, long revision) {
+    }
+
+    private record Grid(int x, int y, int z, int width, int height, int depth, BitSet open, BitSet sky) {
+    }
+}

+package io.papermc.paper.antixray;
+
+import java.util.BitSet;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class CaveVisibilityTest {
+    @Test
+    void boundedBitQueriesHandleWordEdgesAndIgnoreFarAwayBits() {
+        BitSet bits = new BitSet();
+        java.util.Random random = new java.util.Random(417);
+        for (int i = 0; i < 512; i++) if (random.nextInt(5) == 0) bits.set(i);
+        bits.set(63); bits.set(64); bits.set(1_000_000);
+        long[] words = bits.toLongArray();
+        for (int start = 0; start < 1024; start++) {
+            for (int length = 1; length <= 4; length++) {
+                assertEquals(!bits.get(start, start + length).isEmpty(), CaveVisibility.anySet(words, start, start + length));
+            }
+        }
+        assertFalse(CaveVisibility.anySet(words, 900_000, 900_004));
+    }
+
+    @Test
+    void directChunkProjectionMatchesVoxelReferenceAcrossNegativeBoundaries() {
+        int width = 48, height = 384, depth = 48;
+        int baseX = -32, baseY = -64, baseZ = -48;
+        BitSet voxels = new BitSet();
+        BitSet expected = new BitSet();
+        java.util.Random random = new java.util.Random(928);
+        for (int i = 0; i < 2000; i++) voxels.set(random.nextInt(width * height * depth));
+        for (int index = voxels.nextSetBit(0); index >= 0; index = voxels.nextSetBit(index + 1)) {
+            int x = baseX + index % width;
+            int y = baseY + index / (width * depth);
+            int z = baseZ + (index / width) % depth;
+            for (int[] offset : new int[][]{{0,0,0},{-4,0,0},{4,0,0},{0,-4,0},{0,4,0},{0,0,-4},{0,0,4}}) {
+                int bx = x + offset[0], by = y + offset[1], bz = z + offset[2];
+                if (bx >= -16 && bx < 0 && bz >= -32 && bz < -16 && by >= -64 && by < 320) {
+                    expected.set(CaveVisibility.cellIndex(bx, by, bz, -64));
+                }
+            }
+        }
+        assertEquals(expected, CaveVisibility.projectToChunk(voxels, baseX, baseY, baseZ, width, height, depth, -64, 320, -16, -32));
+    }
+
+    @Test
+    void exteriorStopsInsideTheEntranceAndDoesNotRevealSealedAir() {
+        BitSet open = new BitSet();
+        open.set(0, 21); open.set(30, 41);
+        BitSet sky = new BitSet(); sky.set(0, 4);
+        BitSet visible = CaveVisibility.exterior(open, sky, 48, 1, 1, 12);
+        assertEquals(16, visible.cardinality());
+        assertTrue(visible.get(15));
+        assertFalse(visible.get(16));
+        assertFalse(visible.get(30));
+    }
+
+    @Test
+    void sealedWallSeparatesCavities() {
+        BitSet open = new BitSet();
+        open.set(0, 9 * 3 * 3);
+        for (int y = 0; y < 3; y++) for (int z = 0; z < 3; z++) open.clear((y * 3 + z) * 9 + 4);
+        BitSet seeds = new BitSet();
+        seeds.set((1 * 3 + 1) * 9 + 1);
+        BitSet visible = CaveVisibility.flood(open, seeds, 9, 3, 3, 32, 81);
+        assertEquals(36, visible.cardinality());
+        assertFalse(visible.get((1 * 3 + 1) * 9 + 5));
+    }
+
+    @Test
+    void tunnelCrossesChunkBoundaryButStopsAtDistanceLimit() {
+        BitSet open = new BitSet();
+        open.set(0, 48);
+        BitSet seed = new BitSet();
+        seed.set(14);
+        BitSet visible = CaveVisibility.flood(open, seed, 48, 1, 1, 12, 48);
+        assertTrue(visible.get(16));
+        assertTrue(visible.get(26));
+        assertFalse(visible.get(27));
+        assertFalse(visible.get(1));
+    }
+
+    @Test
+    void rowsAndLayersDoNotWrapAtVolumeEdges() {
+        BitSet open = new BitSet();
+        open.set(2); // x=2,z=0,y=0
+        open.set(3); // x=0,z=1,y=0; not adjacent
+        open.set(9); // x=0,z=0,y=1; also not adjacent
+        BitSet seeds = new BitSet();
+        seeds.set(2);
+        assertEquals(seeds, CaveVisibility.flood(open, seeds, 3, 2, 3, 12, 18));
+    }
+
+    @Test
+    void visitsStayWithinBudgetAndInputsStayImmutable() {
+        BitSet open = new BitSet();
+        open.set(0, 4096);
+        BitSet seeds = new BitSet();
+        seeds.set(2048);
+        BitSet before = (BitSet)open.clone();
+        BitSet result = CaveVisibility.flood(open, seeds, 16, 16, 16, 24, 100);
+        assertEquals(100, result.cardinality());
+        assertEquals(before, open);
+        assertEquals(1, seeds.cardinality());
+    }
+
+    @Test
+    void sealedAndMissingNeighborBlocksDoNotBecomeReachable() {
+        BitSet open = new BitSet();
+        open.set(0, 16);
+        open.set(32, 48); // Unavailable middle chunk is closed.
+        BitSet seed = new BitSet();
+        seed.set(15);
+        BitSet visible = CaveVisibility.flood(open, seed, 48, 1, 1, 48, 48);
+        assertEquals(16, visible.cardinality());
+        assertFalse(visible.get(32));
+    }
+
+    @Test
+    void negativeCoordinatesAndSectionBoundariesUseTheSameCellMask() {
+        BitSet cells = new BitSet();
+        cells.set(CaveVisibility.cellIndex(-1, -1, -1, -64));
+        assertTrue(CaveVisibility.visible(cells, 15, -4, 15, -64, 320));
+        assertFalse(CaveVisibility.visible(cells, 15, 0, 15, -64, 320));
+        assertTrue(CaveVisibility.visible(cells, 0, 320, 0, -64, 320));
+    }
+}

+            state.queue(key);
+        }
+        when(loader.getSentChunksRaw()).thenReturn(sent);
+        java.util.List<ClientboundLevelChunkWithLightPacket> delivered = new java.util.ArrayList<>();
+        doAnswer(invocation -> {
+            delivered.add((ClientboundLevelChunkWithLightPacket)this.controller.filterPacket(this.player, invocation.getArgument(0), state));
+            return null;
+        }).when(connection).send(any(net.minecraft.network.protocol.Packet.class));
+        this.controller.tickPlayer(this.player);
+        assertEquals(2, delivered.size());
+        assertEquals(1, state.pending.size());
+        this.controller.tickPlayer(this.player);
+        assertEquals(3, delivered.size());
+        assertTrue(state.pending.isEmpty());
+    }
+
+    private java.util.List<net.minecraft.network.protocol.Packet<?>> connectForTicks(CavePlayerState state) throws ReflectiveOperationException {
+        var connection = mock(net.minecraft.server.network.ServerGamePacketListenerImpl.class);
+        java.lang.reflect.Field field = net.minecraft.server.network.ServerGamePacketListenerImpl.class.getField("caveVisibility");
+        field.setAccessible(true); field.set(connection, state);
+        this.player.connection = connection;
+        when(this.player.getDeltaMovement()).thenReturn(net.minecraft.world.phys.Vec3.ZERO);
+        field = Level.class.getField("chunkPacketBlockController");
+        field.setAccessible(true); field.set(this.level, this.controller);
+        when(this.chunk.getLevel()).thenReturn(this.level);
+        var loader = mock(ca.spottedleaf.moonrise.patches.chunk_system.player.RegionizedPlayerChunkLoader.PlayerChunkLoaderData.class);
+        when(this.player.moonrise$getChunkLoader()).thenReturn(loader);
+        when(loader.getSentChunksRaw()).thenReturn(new it.unimi.dsi.fastutil.longs.LongOpenHashSet(new long[]{0L}));
+        java.util.List<net.minecraft.network.protocol.Packet<?>> delivered = new java.util.ArrayList<>();
+        doAnswer(invocation -> {
+            var filtered = this.controller.filterPacket(this.player, invocation.getArgument(0), state);
+            if (filtered != null) delivered.add(filtered);
+            return null;
+        }).when(connection).send(any(net.minecraft.network.protocol.Packet.class));
+        return delivered;
+    }
